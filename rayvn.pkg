#!/usr/bin/env bash

projectName='valt'
projectDescription='Public key encryption for files and archives, using age and minisign. Built with rayvn.'
projectVersion='0.1.1+'
projectReleaseDate=''
docsWorktree='../valt-pages'
pagesHook='bin/valt-pages-hook' # adds the guide to keys and passphrases (see writeKeyInfoGuide)

# Brew formula metadata (used by rayvn/dependencies for formula generation and runtime dep checks)
# gnugrep, coreutils, gnutar, xz and openssl are listed in flake.nix because Nix wrappers use a minimal PATH; macOS and
# Linux already provide them (macOS tar handles .xz itself, and has LibreSSL as openssl), so they are not brew
# dependencies or checked for.
declare -A nixBrewMap=([phraze]='sts10/phraze/phraze' [gnused]='gnu-sed')
declare -a nixBrewExclude=(curl openssl gnugrep coreutils gnutar xz)
declare -A nixBinaryMap=([gnused]='gsed')
declare -A nixPkgTapOverrides=([mrldPkg]='phoggy/mrld/mrld' [typstPkg]='typst') # typstPkg: typst's release binary (see flake.nix)
