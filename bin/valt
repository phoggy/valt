    show bold "directories or multiple files."
    echo
    show "Usage:" bold blue "valt encrypt" "FILE [-a] [--delete] [-f] [-i IDENTITY] [--no-self] [--no-sign] [-o OUTPUT]"
    echo "                    [-r RECIPIENT]... [-R RECIPIENT-FILE]... [--verify]"
    echo
    option "FILE" "The file to encrypt." 41
    option "-i, --identity IDENTITY" "Your private key file, used to sign and to find your public" 41
    option "" "key (the .pub file next to it); default: the default key" 41
    option "" "(see 'valt default-key')." 41
    option "-r, --recipient RECIPIENT" "Also encrypt to this recipient (an age public key). Can be" 41
    option "" "repeated." 41
    option "-R, --recipient-file RECIPIENT-FILE" "Also encrypt to the recipient(s) in this file, e.g. a valt" 41
    option "" ".pub file. Can be repeated." 41
    option "--no-self" "Do not include your own public key as a recipient." 41
    option "--no-sign" "Do not sign the encrypted file." 41
    option "-a, --armor" "Write PEM encoded (text) output." 41
    option "-o, --output OUTPUT" "The output file ('-' for standard output, which requires" 41
    option "" "--no-sign); default: FILE.age." 41
    option "-f, --force" "Overwrite an existing output file." 41
    option "--verify" "Decrypt the result with your private key and confirm it" 41
    option "" "matches FILE." 41
    option "--delete" "Delete FILE after a successful --verify. This is an" 41
    option "" "ordinary delete, not a secure erase." 41
    option "-h, --help" "Print this help message." 41
    declare -F encryptCmdUsageExtra > /dev/null && encryptCmdUsageExtra
    bye "$@"
}

parseKeyInfoArgs() {
    _opts+=(['timeout']="60")
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=keyInfoCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --downloads | -d) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--edit|-t|-d|-e|-k|-h|--key-info|--downloads|--timeout|--help)$ ) ]] && fail "missing value for --downloads"; assertDirectory "$2"; _opts+=(['downloads']="$2"); shift 2 ;;
            --downloads=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --downloads"; assertDirectory "${_value}"; _opts+=(['downloads']="${_value}"); shift ;;
            --edit | -e) _opts+=(['edit']="1"); shift ;;
            --edit=*) fail "--edit does not accept a value" ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --key-info | -k) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--edit|-t|-d|-e|-k|-h|--key-info|--downloads|--timeout|--help)$ ) ]] && fail "missing value for --key-info"; _opts+=(['key-info']="$2"); shift 2 ;;
            --key-info=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --key-info"; _opts+=(['key-info']="${_value}"); shift ;;
            --timeout | -t) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--edit|-t|-d|-e|-k|-h|--key-info|--downloads|--timeout|--help)$ ) ]] && fail "missing value for --timeout"; assertPositiveInt "$2"; _opts+=(['timeout']="$2"); shift 2 ;;
            --timeout=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --timeout"; assertPositiveInt "${_value}"; _opts+=(['timeout']="${_value}"); shift ;;
            --) shift; (( $# == 0 )) || unknownArg "$1" ;;
            *) unknownArg "$1" ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

keyInfoCmdUsage() {
    echo
    show bold "Fill in the paper key's personal information (your key info) in a web page: the letter, the people"
    show bold "who can help, and notes. The page opens in your browser with the current values; when you save it,"
    show bold "valt imports it into the key info file and offers to regenerate the paper key."
    echo
    show "Usage:" bold blue "valt key-info" "[-d DOWNLOADS] [-e] [-k KEY-INFO] [-t TIMEOUT]"
    echo
    option "-k, --key-info KEY-INFO" "Key info file to write (default: key-info.json in the valt config" 31
    option "" "directory)." 31
    option "-d, --downloads DOWNLOADS" "Your browser's downloads directory (default: ~/Downloads)." 31
    option "-t, --timeout TIMEOUT" "How many minutes to wait for the page; the page expires then too." 31
    option "" "(default: 60)" 31
    option "-e, --edit" "Edit the key info file in your editor (\$VISUAL or \$EDITOR) instead of" 31
    option "" "the page." 31
    option "-h, --help" "Print this help message." 31
    echo
    echo "The page works offline and sends nothing anywhere: Save downloads valt-key-info-ID.json,"
    echo "encrypted with a one-time key, which valt imports and then deletes. Cancel leaves the key info"
    echo "file unchanged. Without a browser to show the page on, e.g. over ssh, the file is edited in your"
    echo "editor instead, as with --edit: \$VISUAL or \$EDITOR, run by the shell as git does. valt adds the"
    echo "wait option of editors known to open their own window (e.g. idea, code); for others, it asks you"
    echo "to say when you have saved the file."
    declare -F keyInfoCmdUsageExtra > /dev/null && keyInfoCmdUsageExtra
    bye "$@"
}

parseKeysArgs() {
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=keysCmdUsage
    local _value _mutex
    while (( $# > 0 )); do
        case "$1" in
            --allow-weak-passphrase) _opts+=(['allow-weak-passphrase']="1"); shift ;;
            --allow-weak-passphrase=*) fail "--allow-weak-passphrase does not accept a value" ;;
            --default | -d) _opts+=(['default']="1"); shift ;;
            --default=*) fail "--default does not accept a value" ;;
            --force | -f) _opts+=(['force']="1"); shift ;;
            --force=*) fail "--force does not accept a value" ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --key-info | -k) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--no-default|--style|--allow-weak-passphrase|--output-dir|--no-verify|--template|--default|-t|-q|-f|-d|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --key-info"; assertFile "$2"; _opts+=(['key-info']="$2"); shift 2 ;;
            --key-info=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --key-info"; assertFile "${_value}"; _opts+=(['key-info']="${_value}"); shift ;;
            --name | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--no-default|--style|--allow-weak-passphrase|--output-dir|--no-verify|--template|--default|-t|-q|-f|-d|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --name"; _opts+=(['name']="$2"); shift 2 ;;
            --name=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --name"; _opts+=(['name']="${_value}"); shift ;;
            --no-advice) _opts+=(['no-advice']="1"); shift ;;
            --no-advice=*) fail "--no-advice does not accept a value" ;;
            --no-default) _opts+=(['no-default']="1"); shift ;;
            --no-default=*) fail "--no-default does not accept a value" ;;
            --no-pdf) _opts+=(['no-pdf']="1"); shift ;;
            --no-pdf=*) fail "--no-pdf does not accept a value" ;;
            --no-verify) _opts+=(['no-verify']="1"); shift ;;
            --no-verify=*) fail "--no-verify does not accept a value" ;;
            --output-dir | -o) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--no-default|--style|--allow-weak-passphrase|--output-dir|--no-verify|--template|--default|-t|-q|-f|-d|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --output-dir"; assertDirectory "$2"; _opts+=(['output-dir']="$2"); shift 2 ;;
            --output-dir=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --output-dir"; assertDirectory "${_value}"; _opts+=(['output-dir']="${_value}"); shift ;;
            --quick | -q) _opts+=(['quick']="1"); shift ;;
            --quick=*) fail "--quick does not accept a value" ;;
            --style | -c) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--no-default|--style|--allow-weak-passphrase|--output-dir|--no-verify|--template|--default|-t|-q|-f|-d|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --style"; assertFile "$2"; _opts+=(['style']="$2"); shift 2 ;;
            --style=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --style"; assertFile "${_value}"; _opts+=(['style']="${_value}"); shift ;;
            --template | -t) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--no-default|--style|--allow-weak-passphrase|--output-dir|--no-verify|--template|--default|-t|-q|-f|-d|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --template"; assertFile "$2"; _opts+=(['template']="$2"); shift 2 ;;
            --template=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --template"; assertFile "${_value}"; _opts+=(['template']="${_value}"); shift ;;
            --) shift; (( $# == 0 )) || unknownArg "$1" ;;
            *) unknownArg "$1" ;;
        esac
    done
    _mutex=0
    [[ -v _opts['default'] ]] && (( _mutex++ ))
    [[ -v _opts['no-default'] ]] && (( _mutex++ ))
    (( _opts['help'] || _mutex <= 1 )) || fail "at most one of --default | --no-default may be specified"
    declare -g _failHandler="${_prevFailHandler}"
}

keysCmdUsage() {
    echo
    show bold "Generate an age key pair, with the private key encrypted by a passphrase, plus a PDF paper key as"
    show bold "backup documentation. A strong passphrase is highly encouraged; advice and an opportunity to"
    show bold "generate one will be offered."
    echo
    show "Usage:" bold blue "valt keys" "[-d | --no-default] [--allow-weak-passphrase] [-f] [-k KEY-INFO] [-n NAME]"
    echo "                 [--no-advice] [--no-pdf] [--no-verify] [-o OUTPUT-DIR] [-q] [-c STYLE]"
    echo "                 [-t TEMPLATE]"
    echo
    option "-n, --name NAME" "Name for the key files, e.g. bob -> bob.pub, bob.key (default: your" 33
    option "" "user name, so that shared public keys say whose they are; asked for" 33
    option "" "if it is too generic, e.g. root)." 33
    option "-o, --output-dir OUTPUT-DIR" "Directory for the key files (default: the valt config directory)." 33
    option "-f, --force" "Replace existing key files, once the new ones have been created" 33
    option "" "(asking first, at a terminal). The old ones are kept, renamed" 33
    option "" "NAME-replaced-TIMESTAMP, with their paper key, since files" 33
    option "" "encrypted to the old key need it." 33
    option "--allow-weak-passphrase" "Accept a passphrase that fails the strength and breach check. Not" 33
    option "" "recommended: the passphrase is all that protects the private key." 33
    option "-d, --default" "Make the new key the default key (see 'valt default-key') without" 33
    option "" "asking. Otherwise the first key becomes the default, and you are" 33
    option "" "asked about later ones." 33
    option "--no-default" "Do not make the new key the default key, and do not ask." 33
    option "--no-verify" "Do not verify keys." 33
    option "--no-advice" "Do not show passphrase advice." 33
    option "-q, --quick" "Same as --no-advice --no-verify, and the default key is not offered" 33
    option "" "(--default still applies)." 33
    option "--no-pdf" "Do not generate the paper key PDF." 33
    option "-k, --key-info KEY-INFO" "Key info file to use instead of the default for PDF generation." 33
    option "-t, --template TEMPLATE" "Typst template file to use instead of the default for PDF" 33
    option "" "generation." 33
    option "-c, --style STYLE" "Typst file with style overrides to apply for PDF generation." 33
    option "-h, --help" "Print this help message." 33
    echo
    echo "The PDF contains your keys, also in encrypted form, to serve as a backup for you and/or your"
    echo "successors, along with detailed usage instructions. Keys are represented as a QR code and again in"
    echo "a text format (often called \"paper keys\"). Content is personalized from your key info (see 'valt"
    echo "key-info'); until that is complete, the PDF is skipped and can be generated later with 'valt paper'."
    echo
    echo "The PDF is opened when done, so that you can check and print it. Please ensure that you print at"
    echo "least one copy, then either write your passphrase on the last page or, more securely, say in the"
    echo "Notes section where to find it, and store copies in secure locations, e.g. safe deposit box/fire"
    echo "safe and/or with trusted people!"
    echo
    echo "Document Customization"
    echo
    echo "The PDF is typeset by typst (https://typst.app). The template can be replaced, and style overrides"
    echo "applied, with typst files: the default template (key-doc-template.typ) and an example style file"
    echo "(key-doc-style.typ) are in the valt 'etc' directory. Every value in the key info file is available"
    echo "to the template as data.NAME (e.g. data.author; each of data.contacts has a name and ways, each with"
    echo "a type and value); data.generated holds values set by valt."
    declare -F keysCmdUsageExtra > /dev/null && keysCmdUsageExtra
    bye "$@"
}

parsePaperArgs() {
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=paperCmdUsage
    local _argIndex=0 _value
    while (( $# > 0 )); do
        case "$1" in
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --key-info | -k) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--style|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --key-info"; assertFile "$2"; _opts+=(['key-info']="$2"); shift 2 ;;
            --key-info=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --key-info"; assertFile "${_value}"; _opts+=(['key-info']="${_value}"); shift ;;
            --name | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--style|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --name"; _opts+=(['name']="$2"); shift 2 ;;
            --name=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --name"; _opts+=(['name']="${_value}"); shift ;;
            --style | -c) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--style|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --style"; assertFile "$2"; _opts+=(['style']="$2"); shift 2 ;;
            --style=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --style"; assertFile "${_value}"; _opts+=(['style']="${_value}"); shift ;;
            --template | -t) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--style|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --template"; assertFile "$2"; _opts+=(['template']="$2"); shift 2 ;;
            --template=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --template"; assertFile "${_value}"; _opts+=(['template']="${_value}"); shift ;;
            --) shift
                while (( $# > 0 )); do
                    (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"
                    _args+=("$1"); (( _argIndex++ )); shift
                done ;;
            *) (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"; _args+=("$1"); (( _argIndex++ )); shift ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

