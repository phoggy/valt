    echo
    show bold "Verify and extract a secure archive (.valt). Same as 'valt decrypt ARCHIVE'."
    echo
    show "Usage:" bold blue "valt archive extract" "ARCHIVE [--identity IDENTITY] [--output-dir OUTPUT-DIR]"
    echo
    option "ARCHIVE" "The secure archive (.valt)." 33
    option "--identity, -i IDENTITY" "Your private key file (default: valt.key in the valt config" 33
    option "" "directory)." 33
    option "--output-dir, -o OUTPUT-DIR" "The existing directory to extract into (default: the current" 33
    option "" "directory)." 33
    option "--help, -h" "Print this help message." 33
    declare -F archiveExtractCmdUsageExtra > /dev/null && archiveExtractCmdUsageExtra
    bye "$@"
}

