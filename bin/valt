verifyCmdUsage() {
    echo
    show bold "Verify a key pair, and optionally files encrypted or archived with it. You will be prompted for the"
    show bold "passphrase that protects the private key, once."
    echo
    show "Usage:" bold blue "valt verify" "[FILE...] [-i IDENTITY]"
    echo
    option "FILE..." "Public keys (.pub) to check against the private key, and encrypted" 29
    option "" "files (e.g. .age) and secure archives (.valt) to verify." 29
    option "-i, --identity IDENTITY" "The private key file (default: the default key; see 'valt" 29
    option "" "default-key')." 29
    option "-h, --help" "Print this help message." 29
    echo
    echo "The private key must decrypt with its passphrase. Each public key must match it: the keys it"
    echo "contains must be the private key's, a file encrypted to it must decrypt with the private key,"
    echo "and a signature made with the private key must verify. With no public key given, the .pub"
    echo "file next to the private key is used, if there is one."
    echo
    echo "Each encrypted file must decrypt with the private key (nothing is written), and its signature"
    echo "(FILE.minisig) must verify if it has one; a warning is shown if it does not. Each secure"
    echo "archive must have both of its signatures verify, as with 'valt archive verify'."
    declare -F verifyCmdUsageExtra > /dev/null && verifyCmdUsageExtra
    bye "$@"
}

ARGS_PARSER_END="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 🚫 END generated code: DO NOT EDIT 🚫 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

SECTION="--+-+-----+-++(-++(---++++(---+( COMMANDS )+---)++++---)++-)++-+------+-+--"

keysCmd() {
    require 'valt/paper-keys'
    local name="${_opts['name']}"
    [[ -n ${name} ]] || name="${ defaultValtKeyName; }" || askKeyName name
    assertValidFileName "${name}"
    local outputDir="${_opts['output-dir']:-${valtConfigDir}}"
    local publicKeyFile="${outputDir}/${name}.${valtPublicKeySuffix}"
    local privateKeyFile="${outputDir}/${name}.${valtPrivateKeySuffix}"
    local verify=1 offerDefault=1
    (( _opts['no-verify'] || _opts['quick'] )) && verify=0
    (( _opts['no-default'] || ( _opts['quick'] && ! _opts['default'] ) )) && offerDefault=0
    (( _opts['no-advice'] || _opts['quick'] )) && declare -gx skipKeyPassphraseAdvice=1
    (( _opts['allow-weak-passphrase'] )) && declare -gx allowWeakKeyPassphrase=1

    # Replacing keys keeps the old ones, renamed: files encrypted to the old key can only be decrypted with it

    local replacedName=''
    if [[ -e ${privateKeyFile} || -e ${publicKeyFile} ]]; then
        if (( ! _opts['force'] )); then
            assertFileDoesNotExist "${privateKeyFile}"
            assertFileDoesNotExist "${publicKeyFile}"
        fi
        replacedName="${name}-replaced-${ printf '%(%Y-%m-%d_%H.%M.%S)T' -1; }"
        confirmKeyReplacement "${privateKeyFile}" "${replacedName}"
    fi

    createKeys "${name}" "${outputDir}" "${publicKeyFile}" "${privateKeyFile}" ${verify} "${replacedName}"
    (( offerDefault )) && offerDefaultKey "${privateKeyFile}" "${_opts['default']:-0}"

    # The paper key's next steps include backing up the private key; without one, say so here

    if (( _opts['no-pdf'] )); then
        showKeyBackupAdvice "${privateKeyFile}"
    elif isKeyInfoComplete "${_opts['key-info']:-${valtConfigDir}/key-info.json}"; then
        generatePaperKey "${privateKeyFile}"
        openPaperKey "${privateKeyFile}"
    else
        showKeyBackupAdvice "${privateKeyFile}"
        showPaperKeyDeferred "${privateKeyFile}"
    fi
}

paperCmd() {
    require 'valt/paper-keys'
    local keyFile="${_args[0]:-}"
    if [[ -n ${_opts['name']} ]]; then
        [[ -z ${keyFile} ]] || paperCmdUsage "Specify either --name or KEY_FILE, not both."
        assertValidFileName "${_opts['name']}"
        keyFile="${valtConfigDir}/${_opts['name']}.${valtPrivateKeySuffix}"
    fi
    [[ -n ${keyFile} ]] || keyFile="${ defaultValtKeyFile; }"
    assertFile "${keyFile}" "private key file"
    generatePaperKey "${keyFile}"
    openPaperKey "${keyFile}"
}

decryptCmd() {
    local file="${_args[0]}"
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"

    if [[ ${file} == *.valt ]]; then
        extractArchive "${file}" "${keyFile}" "${_opts['output']:-${PWD}}"
    else
        decryptFile "${file}" "${keyFile}"
    fi
}

encryptCmd() {
    require 'valt/paper-keys'
    local file="${_args[0]}"
    [[ -d ${file} ]] && encryptCmdUsage "${file} is a directory; use 'valt archive create' for directories and multiple files."
    assertFile "${file}"
    (( _opts['delete'] && ! _opts['verify'] )) && encryptCmdUsage "--delete requires --verify."
    (( _opts['verify'] && _opts['no-self'] )) && encryptCmdUsage "--verify cannot be combined with --no-self, since your key could not decrypt the file."

    local output="${_opts['output']:-${file}.${_ageFileExtension}}"
    local sign=1
    (( _opts['no-sign'] )) && sign=0
    if [[ ${output} == '-' ]]; then
        (( sign )) && encryptCmdUsage "Signing requires an output file; use --no-sign with '--output -'."
        (( _opts['verify'] )) && encryptCmdUsage "--verify requires an output file."
    else
        assertCanWrite "${output}"
        (( sign )) && assertCanWrite "${output}.${_signatureFileSuffix}"
    fi

    local keyFile; keyFile="${ identityKeyFile; }"
    local -a recipientArgs=()
    addRecipientArgs recipientArgs "${keyFile}" encryptCmdUsage
    assertCompatibleRecipients "${recipientArgs[@]}"

    # Signing and verification both decrypt the private key, so ask for its passphrase once.
    # Shadow with a local so that it goes out of scope when we return.

    local rayvnTest_ValtKeyPassphrase="${rayvnTest_ValtKeyPassphrase}"
    if (( sign || _opts['verify'] )); then
        assertFile "${keyFile}" "private key file"
        _prepareKey "${keyFile}"
    fi

    local -a encryptArgs=("${file}" "${recipientArgs[@]}")
    (( _opts['armor'] )) && encryptArgs+=(--armor)
    if [[ ${output} == '-' ]]; then
        encrypt "${encryptArgs[@]}" || fail
        return 0
    fi
    encrypt "${encryptArgs[@]}" -o "${output}" || fail
    show "Encrypted" cyan "${ tildePath "${file}"; }" "to" bold "${ tildePath "${output}"; }"

    if (( sign )); then
        signFile "${keyFile}" "${output}"
        show "Signed" bold "${ tildePath "${output}"; }" "with" cyan "${ tildePath "${keyFile}"; }"
    fi
    (( _opts['verify'] )) && verifyEncryptedFile "${file}" "${output}" "${keyFile}"
    if (( _opts['delete'] )); then
        rm "${file}" || fail
        show "Deleted" bold "${ tildePath "${file}"; }"
    fi
    return 0
}

archiveCreateCmd() {
    require 'valt/paper-keys' 'valt/archive'
    (( ${#_args[@]} )) || archiveCreateCmdUsage "missing required argument: INPUT..."
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    local -a recipientArgs=()
    addRecipientArgs recipientArgs "${keyFile}" archiveCreateCmdUsage
    assertCompatibleRecipients "${recipientArgs[@]}"

    local -a args=("${_args[@]}" -i "${keyFile}" "${recipientArgs[@]}")
    [[ -n ${_opts['name']} ]] && args+=(-n "${_opts['name']}")
    [[ -n ${_opts['zone']} ]] && args+=(-z "${_opts['zone']}")
    [[ -n ${_opts['user-text']} ]] && args+=(-u "${_opts['user-text']}")
    [[ -n ${_opts['output-dir']} ]] && args+=(-o "${_opts['output-dir']}")
    (( _opts['force'] )) && args+=(-f)
    (( _opts['no-mac-metadata'] )) && args+=(--no-mac-metadata)

    local archive; archive="${ newSecureArchive "${args[@]}"; }" || fail
    show "Created secure archive" bold "${ tildePath "${archive}"; }"
    show "Public companion (safe to share):" cyan "${ tildePath "${archive}.pub"; }"
}

archiveVerifyCmd() {
    require 'valt/archive'
    local archive="${_args[0]}"
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    show "Verifying secure archive" cyan "${ tildePath "${archive}"; }"
    verifySecureArchive "${archive}" -i "${keyFile}" || fail
    show "Signatures verified for" bold "${ tildePath "${archive}"; }"
}

archiveExtractCmd() {
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    extractArchive "${_args[0]}" "${keyFile}" "${_opts['output-dir']:-${PWD}}"
}

passphraseCmd() {
    require 'valt/password'
    local phrase i
    for (( i = 0; i < _opts['count']; i++ )); do
        if [[ -n ${_opts['separator']+set} ]]; then
            generatePassphrase phrase "${_opts['words']}" "${_opts['separator']}"
        else
            generatePassphrase phrase "${_opts['words']}"
        fi
        [[ -n ${phrase} ]] || fail "failed to generate a passphrase"
        echo "${phrase}"
    done
}

passwordCmd() {
    require 'valt/password'
    (( _opts['min'] <= _opts['max'] )) || passwordCmdUsage "--min must not be greater than --max."
    local password i
    for (( i = 0; i < _opts['count']; i++ )); do
        generatePassword password "${_opts['min']}" "${_opts['max']}"
        echo "${password}"
    done
}

passCheckCmd() {
    require 'valt/password'
    if (( ! _opts['breach-only'] )); then
        checkSecretStrength
        return
    fi
    local secret apiError breachCount
    readSecret "Enter password or passphrase" secret
    hasNotBeenPwned secret apiError breachCount
    case $? in
        0) show success "Not found in any known breach." ;;
        1) fail "Unable to check for breaches: ${ _curlErrorMessage "${apiError}"; }" ;;
        2)
            local plural='es'; (( breachCount == 1 )) && plural=''
            show error "Found in ${ printf "%'d" "${breachCount}"; } breach${plural}." "Do not use it."
            return 1
            ;;
    esac
}

publicKeyCmd() {
    local keyFile="${_args[0]:-${ defaultValtKeyFile; }}"
    assertFile "${keyFile}" "private key file"
    local pubFile="${_opts['output']:-${keyFile%.${valtPrivateKeySuffix}}.${valtPublicKeySuffix}}"
    if [[ -e ${pubFile} ]] && (( ! _opts['force'] )); then
        publicKeyCmdUsage "${ tildePath "${pubFile}"; } already exists; use --force to replace it, or 'valt verify' to check it."
    fi
    writeValtPublicKey "${keyFile}" "${pubFile}"
    show "Wrote" bold "${ tildePath "${pubFile}"; }" "from" bold "${ tildePath "${keyFile}"; }" glue "."
}

verifyCmd() {
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    local -a publicKeyFiles=() encryptedFiles=() archiveFiles=()
    local file
    for file in "${_args[@]}"; do
        assertFile "${file}"
        if [[ "${file}" == *."${valtPublicKeySuffix}" ]]; then
            publicKeyFiles+=("${file}")
        elif [[ "${file}" == *.valt ]]; then
            archiveFiles+=("${file}")
        elif isAgeEncryptedFile "${file}"; then
            encryptedFiles+=("${file}")
        else
            verifyCmdUsage "not a public key (.${valtPublicKeySuffix}), encrypted file or secure archive (.valt): ${file}"
        fi
    done
    if (( ! ${#publicKeyFiles[@]} )); then
        local defaultPublicKey="${keyFile%."${valtPrivateKeySuffix}"}.${valtPublicKeySuffix}"
        [[ -f "${defaultPublicKey}" ]] && publicKeyFiles=("${defaultPublicKey}")
    fi

    # Ask for the passphrase once, for every check. Shadow with a local so that it goes out of scope when we return.

    local rayvnTest_ValtKeyPassphrase="${rayvnTest_ValtKeyPassphrase}"
    _prepareKey "${keyFile}"
    recipient "${keyFile}" > /dev/null || fail
    show "Private key" bold "${ tildePath "${keyFile}"; }" "decrypts with its passphrase. ${successCheckMark}"
    (( ${#publicKeyFiles[@]} )) || show italic "No public key was found next to it to check against."

    for file in "${publicKeyFiles[@]}"; do
        verifyValtKeys "${file}" "${keyFile}"
        show "Public key" bold "${ tildePath "${file}"; }" "matches the private key. ${successCheckMark}"
    done

    for file in "${encryptedFiles[@]}"; do
        verifySignatureIfPresent "${file}" "${keyFile}"
        decrypt -i "${keyFile}" -o /dev/null "${file}" || fail
        if [[ -f "${file}.${_signatureFileSuffix}" ]]; then
            show "Encrypted file" bold "${ tildePath "${file}"; }" "decrypts with the private key, and its signature verifies. ${successCheckMark}"
        else
            show "Encrypted file" bold "${ tildePath "${file}"; }" "decrypts with the private key. ${successCheckMark}"
        fi
    done

    if (( ${#archiveFiles[@]} )); then
        require 'valt/archive'
        for file in "${archiveFiles[@]}"; do
            verifySecureArchive "${file}" -i "${keyFile}" || fail
            show "Signatures verified for" bold "${ tildePath "${file}"; }" "${successCheckMark}"
        done
    fi
}

defaultKeyCmd() {
    if (( _opts['clear'] )); then
        [[ -z ${_args[0]:-} ]] || defaultKeyCmdUsage "Specify either KEY_FILE or --clear, not both."
        setDefaultValtKeyFile
        show "Removed the default key setting."
    elif [[ -n ${_args[0]:-} ]]; then
        setDefaultValtKeyFile "${_args[0]}"
        show "Default key set to" bold "${ tildePath "${ defaultValtKeyFile; }"; }" glue "."
        [[ -n ${VALT_KEY_FILE:-} ]] && warn "VALT_KEY_FILE is set, and overrides this setting."
    fi

    local keyFile; keyFile="${ defaultValtKeyFile; }"
    local source; source="${ defaultValtKeyFileSource; }"
    if [[ ${source} == built-in && ! -f ${keyFile} ]]; then
        show "No key exists yet; create a key pair with" bold blue "valt keys" glue "."
        return 0
    fi
    case "${source}" in
        VALT_KEY_FILE) source='the VALT_KEY_FILE environment variable' ;;
        built-in) source='the built-in default' ;;
        *) source="${ tildePath "${source}"; }" ;;
    esac
    show "Default key:" bold "${ tildePath "${keyFile}"; }" "(from ${source})"
    [[ -f "${keyFile}" ]] || warn "${ tildePath "${keyFile}"; } does not exist; create a key pair with 'valt keys'."
    return 0
}

SECTION="--+-+-----+-++(-++(---++++(---+( SHARED FUNCTIONS )+---)++++---)++-)++-+------+-+--"

# Prompts for a password or passphrase, then shows its strength report for the use-case and threat-level options.
# Returns 1 if it is unsafe to use, or 2 if it is strong enough but known breaches could not be checked.

checkSecretStrength() {
    local secret score line
    local -a report=()
    readSecret "Enter password or passphrase" secret
    passwordStrength secret "${_opts['use-case']}" "${_opts['threat-level']}" score report
    local result=$?
    echo
    for line in "${report[@]}"; do
        echo "${line}"
    done
    return ${result}
}

# Reads a secret into the named var: with a hidden prompt on a terminal, otherwise one line from standard input.

readSecret() {
    local prompt="$1"
    local -n secretRef=$2
    if [[ -t 0 ]]; then
        readPassword "${prompt}" secretRef || fail
    else
        IFS= read -r secretRef || [[ -n ${secretRef} ]] || fail "no input"
    fi
    [[ -n ${secretRef} ]] || fail "cancelled"
}

createKeys() {
    local name="$1" outputDir="$2" publicKeyFile="$3" privateKeyFile="$4" verify=$5 replacedName="${6:-}"
    echo
    header -u "Generating Keys"

    # When replacing, create the new keys elsewhere first, so that a failure (e.g. a rejected passphrase) leaves the
    # existing keys in place; then keep the existing ones, renamed to replacedName.

    if [[ -n ${replacedName} ]]; then

        # Stage in the output directory, so that the move is a rename on the same file system

        declare -g keysStagingDir="${outputDir}/.${name}-new-$$"
        addExitHandler removeKeysStagingDir
        withUmask 0077 mkdir "${keysStagingDir}" || fail "could not create ${keysStagingDir}"
        newValtKeys "${name}" "${keysStagingDir}" || fail
        keepReplacedKeys "${privateKeyFile}" "${publicKeyFile}" "${outputDir}/${replacedName}"
        mv -f "${keysStagingDir}/${name}.${valtPublicKeySuffix}" "${publicKeyFile}" || fail
        mv -f "${keysStagingDir}/${name}.${valtPrivateKeySuffix}" "${privateKeyFile}" || fail
        removeKeysStagingDir
    else
        newValtKeys "${name}" "${outputDir}" || fail
    fi
    echo
    show "Public key (aka 'recipient') file:" cyan "${ tildePath "${publicKeyFile}"; }" "(includes public signing key)"
    show "Private key (aka 'identity') file:" cyan "${ tildePath "${privateKeyFile}"; }" "(includes public key and both signing keys)"

    if (( verify )); then
        echo
        header 2 "Verifying keys"
        verifyValtKeys "${publicKeyFile}" "${privateKeyFile}"
        show bold "Verified" glue ":"
        echo
        show "  · A file encrypted with" cyan "${name}.pub" "decrypts with passphrase and the" cyan "${name}.key" "private key. ${successCheckMark}"
        show "  · A signature created with" cyan "${name}.key" "for the encrypted file matches. ${successCheckMark} "
    fi
}

# Sets the named var to a name for a new key, asked for at a terminal (for when the user name is too generic to name
# it by; see defaultValtKeyName), otherwise fails.

askKeyName() {
    local -n askedNameRef=$1
    [[ -t 0 && -t 1 ]] || fail "your user name (${USER:-none}) is too generic to name a key by; give a name with --name"
    require 'rayvn/prompt'
    echo
    show "Your user name" bold "${USER:-}" "is too generic to name your key by, since public keys are shared."
    while true; do
        request "Name for the key, e.g. your first name" askedNameRef true || bye
        [[ ${askedNameRef} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && return 0
        warn "Use letters, digits, '.', '_' or '-', starting with a letter or digit."
    done
}

# Asks, at a terminal, whether to replace an existing key (which --force asks for), saying that it will be kept as
# replacedName; exits if not. Without a terminal, --force is taken as the answer.

confirmKeyReplacement() {
    local keyFile="$1" replacedName="$2"
    [[ -t 0 && -t 1 ]] || return 0
    require 'rayvn/prompt'
    local choiceIndex=1
    echo
    show "Files encrypted to" bold "${ tildePath "${keyFile}"; }" "can only be decrypted with it, so it will be kept as" \
         bold "${replacedName}.${valtPrivateKeySuffix}" glue ", along with its public key and paper key."
    confirm "Replace it with a new key?" yes no choiceIndex true
    (( choiceIndex == 0 )) || bye "Cancelled; ${ tildePath "${keyFile}"; } is unchanged."
}

# Keeps the keys being replaced, and the private key's paper key, by renaming them to the given base path (the
# public key and paper key only if they exist), saying where they are.

keepReplacedKeys() {
    local privateKeyFile="$1" publicKeyFile="$2" basePath="$3"
    local keptKey="${basePath}.${valtPrivateKeySuffix}" keptPub="${basePath}.${valtPublicKeySuffix}"
    local paperKey; paperKey="${ _paperKeyFile "${privateKeyFile}"; }"
    local -a kept=()
    if [[ -e ${privateKeyFile} ]]; then
        mv "${privateKeyFile}" "${keptKey}" || fail "could not keep ${privateKeyFile} as ${keptKey}"
        kept+=("${ tildePath "${keptKey}"; }")
        if [[ -e ${paperKey} ]]; then
            local keptPaperKey; keptPaperKey="${ _paperKeyFile "${keptKey}"; }"
            mv "${paperKey}" "${keptPaperKey}" || fail "could not keep ${paperKey} as ${keptPaperKey}"
            kept+=("${ tildePath "${keptPaperKey}"; }")
        fi
    fi
    if [[ -e ${publicKeyFile} ]]; then
        mv "${publicKeyFile}" "${keptPub}" || fail "could not keep ${publicKeyFile} as ${keptPub}"
        kept+=("${ tildePath "${keptPub}"; }")
    fi
    (( ${#kept[@]} )) || return 0
    show "Kept the previous key, for the files encrypted to it:" nl
    printList "${kept[@]}"
    echo "Keep it, its backups and its printed paper key copies for as long as you have such files."
    echo
}

# Generates the paper key for privateKeyFile using the key-info, template and style options.

generatePaperKey() {
    local privateKeyFile keyInfoFile='' styleFile='' templateFile=''

    # newPaperKey changes to a work directory, so resolve all paths first.

    setFileVar privateKeyFile "$1" "private key file"
    [[ -n ${_opts['key-info']} ]] && setFileVar keyInfoFile "${_opts['key-info']}" "key info file"
    [[ -n ${_opts['style']} ]] && setFileVar styleFile "${_opts['style']}" "style file"
    [[ -n ${_opts['template']} ]] && setFileVar templateFile "${_opts['template']}" "template file"

    local existingPdf; existingPdf="${ _paperKeyFile "${privateKeyFile}"; }"
    local replacing=0
    [[ -f "${existingPdf}" ]] && replacing=1

    echo
    header -u "Generating Paper Key"

    local paperKeyFile
    newPaperKey "${privateKeyFile}" paperKeyFile "${keyInfoFile}" "${styleFile}" "${templateFile}"

    show "Paper key file:" cyan "${ tildePath "${paperKeyFile}"; }"
    echo

    showPaperKeyNextSteps "${privateKeyFile}" ${replacing}
}

# Decrypts a single file, verifying its signature first if present.

decryptFile() {
    local file="$1" keyFile="$2"
    local output="${_opts['output']}"
    if [[ -z ${output} ]]; then
        [[ ${file} == *.${_ageFileExtension} ]] \
            || decryptCmdUsage "Cannot derive an output file name from '${file}'; use --output."
        output="${file%.${_ageFileExtension}}"
    fi
    [[ ${output} == '-' ]] || assertCanWrite "${output}"

    # Verifying a signature and decrypting both decrypt the private key, so ask for its passphrase once. Shadow with a
    # local so that it goes out of scope when we return.

    local rayvnTest_ValtKeyPassphrase="${rayvnTest_ValtKeyPassphrase}"
    [[ -f "${file}.${_signatureFileSuffix}" ]] && _prepareKey "${keyFile}"
    verifySignatureIfPresent "${file}" "${keyFile}"

    if [[ ${output} == '-' ]]; then
        decrypt -i "${keyFile}" "${file}" || fail
    else
        decrypt -i "${keyFile}" -o "${output}" "${file}" || fail
        show "Decrypted" cyan "${ tildePath "${file}"; }" "to" bold "${ tildePath "${output}"; }"
    fi
}

# Verifies a single file's detached signature, failing on mismatch and warning if it cannot be checked.

verifySignatureIfPresent() {
    local file="$1" keyFile="$2"
    local signatureFile="${file}.${_signatureFileSuffix}"
    local path; path="${ tildePath "${file}"; }"
    if [[ ! -f "${signatureFile}" ]]; then
        warn "No signature found for" bold "${path}" glue "; its authenticity cannot be verified."
    elif ! command -v minisign &> /dev/null; then
        warn "minisign is not installed; the signature for" bold "${path}" "was not verified."
    else
        ( verifyFileSignature "${keyFile}" "${file}" "${signatureFile}" ) &> /dev/null \
            || fail "Signature verification failed for ${path}: it may have been modified, or was signed with a different key."
    fi
}

# Verifies and extracts a secure archive into destDir.

extractArchive() {
    local file="$1" keyFile="$2" destDir="$3"
    require 'valt/archive'
    show "Verifying and extracting secure archive" cyan "${ tildePath "${file}"; }"
    extractSecureArchive "${file}" -i "${keyFile}" -o "${destDir}" || fail
    show "Extracted to" bold "${ tildePath "${destDir}"; }"
}

# Removes the directory in which replacement keys are created, if any (also run on exit, e.g. after a failure).

removeKeysStagingDir() {
    [[ -n ${keysStagingDir:-} && -d ${keysStagingDir} ]] && rm -rf "${keysStagingDir}"
    return 0
}

# Opens the paper key PDF for keyFile in the default viewer, only on a terminal (not in scripts or tests), so that it
# can be checked and printed; without a display (e.g. over ssh), says how to copy it to print it instead. Failing to
# open it is not an error, since it has been saved.

openPaperKey() {
    [[ -t 0 && -t 1 ]] || return 0
    local pdfFile; pdfFile="${ _paperKeyFile "$1"; }"
    [[ -f "${pdfFile}" ]] || return 0
    local path; path="${ tildePath "${pdfFile}"; }"
    if ! canOpenUrls; then
        show nl "There is no display here to open the paper key on (e.g. over ssh). Copy it to a computer that can print" \
             "it, e.g. with" bold blue "scp HOST:${path} ." glue ", then delete the copy once printed: it holds your key," \
             "encrypted."
        return 0
    fi
    ( openUrl "${pdfFile}" ) &> /dev/null || warn "Could not open" bold "${path}" glue "; open it to check and print it."
    return 0
}

# Makes keyFile the default key if makeDefault or there is no default key yet (the first key), or if the user agrees
# when asked (only on a terminal), unless it is already the default; otherwise shows how to do so later. The question
# preselects no, so that a quick test key does not replace the default by accident.

offerDefaultKey() {
    local keyFile; keyFile="${ cd "${ dirname "$1"; }" && pwd -P; }/${ basename "$1"; }"
    local makeDefault=$2
    local defaultKey; defaultKey="${ defaultValtKeyFile; }"
    [[ -f "${defaultKey}" ]] && defaultKey="${ cd "${ dirname "${defaultKey}"; }" && pwd -P; }/${ basename "${defaultKey}"; }"
    [[ ${keyFile} == "${defaultKey}" ]] && return 0

    local path; path="${ tildePath "${keyFile}"; }"
    if [[ ! -f "${defaultKey}" ]]; then
        makeDefault=1 # the first key: no need to ask
    elif (( ! makeDefault )) && [[ -t 0 && -t 1 ]]; then
        require 'rayvn/prompt'
        local choiceIndex=1
        echo
        confirm "Use ${path} as your default key, when no key is given?" yes no choiceIndex true
        (( choiceIndex == 0 )) && makeDefault=1
    fi

    echo
    if (( makeDefault )); then
        setDefaultValtKeyFile "${keyFile}"
        show "Default key set to" bold "${path}" glue "."
        [[ -n ${VALT_KEY_FILE:-} ]] && warn "VALT_KEY_FILE is set, and overrides this setting."
    else
        show "To use this key when no key is given, run:" primary "valt default-key ${path}"
    fi
    return 0
}

# Outputs the private key file from --identity, or the default key (see defaultValtKeyFile).

identityKeyFile() {
    echo "${_opts['identity']:-${ defaultValtKeyFile; }}"
}

# Adds -r/-R recipient args from the --recipient, --recipient-file and --no-self options. Unless --no-self is
# given, the public key next to keyFile is included. Calls usageFunction if there would be no recipients.

addRecipientArgs() {
    local -n recipientArgsRef=$1
    local keyFile="$2" usageFunction="$3"
    if (( ! _opts['no-self'] )); then
        local publicKeyFile="${keyFile%.${valtPrivateKeySuffix}}.${valtPublicKeySuffix}"
        [[ -f "${publicKeyFile}" ]] || fail "No public key found at ${ tildePath "${publicKeyFile}"; }; recreate it with" \
            "'valt public-key ${ tildePath "${keyFile}"; }', or use --no-self with --recipient or --recipient-file."
        recipientArgsRef+=(-R "${publicKeyFile}")
    fi
    local recipient
    for recipient in "${_optListRecipient[@]}"; do recipientArgsRef+=(-r "${recipient}"); done
    for recipient in "${_optListRecipientFile[@]}"; do recipientArgsRef+=(-R "${recipient}"); done
    (( ${#recipientArgsRef[@]} )) || ${usageFunction} "--no-self requires at least one --recipient or --recipient-file."
}

# Fails if file exists, unless --force was given.

assertCanWrite() {
    [[ -e "$1" ]] || return 0
    (( _opts['force'] )) || fail "${ tildePath "$1"; } already exists; use --force to overwrite."
}

# Decrypts encryptedFile with keyFile and fails unless the result matches originalFile.

verifyEncryptedFile() {
    local originalFile="$1" encryptedFile="$2" keyFile="$3"
    local workDir; makeSecureTempDir workDir
    decrypt -i "${keyFile}" -o "${workDir}/decrypted" "${encryptedFile}" || fail
    local originalHash; originalHash="${ sha256sum < "${originalFile}"; }"
    local decryptedHash; decryptedHash="${ sha256sum < "${workDir}/decrypted"; }"
    [[ ${originalHash} == "${decryptedHash}" ]] \
        || fail "Verification failed: ${ tildePath "${encryptedFile}"; } does not decrypt to ${ tildePath "${originalFile}"; }."
    show "Verified" bold "${ tildePath "${encryptedFile}"; }" "decrypts to match" cyan "${ tildePath "${originalFile}"; }"
}

# Opens the key info page, waits for its download, imports it into the key info file, and, if that changed it, offers to
# regenerate the default key's paper key.

keyInfoCmd() {
    require 'valt/key-info' 'valt/paper-keys' 'rayvn/spinner'
    local keyInfoFile="${_opts['key-info']:-${valtConfigDir}/key-info.json}"
    if (( _opts['edit'] )) || { [[ -z ${rayvnTest_KeyInfoNoBrowser:-} ]] && ! canOpenUrls; }; then
        editKeyInfo "${keyInfoFile}"
        return 0
    fi
    local downloadsDir="${_opts['downloads']:-${HOME}/Downloads}"
    [[ -d ${downloadsDir} ]] || keyInfoCmdUsage "There is no ${ tildePath "${downloadsDir}"; } directory; use --downloads."

    # The page goes in the system's per-user temp dir rather than rayvn's, which macOS hides from Finder and browsers
    # (opening a page from there shows Finder or an empty window). It holds contact details but no secrets, and is
    # removed on exit.

    declare -g _keyInfoPageDir; _keyInfoPageDir="${ mktemp -d "${TMPDIR:-/tmp}/valt-key-info.XXXXXX"; }" || fail
    addExitHandler removeKeyInfoPageDir
    local timeoutSeconds=$(( ${_opts['timeout']:-60} * 60 ))
    [[ -n ${rayvnTest_KeyInfoTimeoutSeconds:-} ]] && timeoutSeconds=${rayvnTest_KeyInfoTimeoutSeconds}

    # Say what is about to happen, and ask, rather than a browser window appearing unannounced

    if [[ -z ${rayvnTest_KeyInfoNoBrowser:-} && -t 0 && -t 1 ]]; then
        require 'rayvn/prompt'
        echo
        show "valt opens a page in your web browser to fill in your paper key's information, then waits here until you" \
             "press" bold "Save" "or" bold "Cancel" "on the page (for up to ${ _countOfMinutes $(( timeoutSeconds / 60 )); })."
        local choiceIndex
        echo
        if ! confirm "Open the page in your browser?" yes no choiceIndex || (( choiceIndex != 0 )); then
            show nl "Ok, nothing was opened. To edit your key info in your editor instead, run" bold blue "valt key-info --edit" \
                 glue "."
            return 0
        fi
    fi
    local deadline=$(( EPOCHSECONDS + timeoutSeconds ))
    local pageFile pageKeys; newKeyInfoPage "${keyInfoFile}" "${_keyInfoPageDir}" pageFile pageKeys ${deadline}
    local markerFile="${_keyInfoPageDir}/opened"
    touch "${markerFile}" || fail

    echo
    if [[ -n ${rayvnTest_KeyInfoNoBrowser:-} ]]; then
        show "Key info page:" "${pageFile}"
    elif ! ( openKeyInfoPage "${pageFile}" ) &> /dev/null; then
        warn "Could not open the page; open it in your browser:" bold "${pageFile}"
    fi
    show "When you press" bold "Save" glue ", valt picks up" bold "valt-key-info-${pageKeys%% *}.json" "from" \
         blue "${ tildePath "${downloadsDir}"; }" glue "."
    local spinnerId download
    startSpinner spinnerId "Waiting for your key info (Ctrl-C to cancel)"
    if ! download="${ waitForKeyInfoDownload "${downloadsDir}" "${markerFile}" "${pageKeys}" ${deadline}; }"; then
        stopSpinner spinnerId ""
        show "Stopped waiting after ${ _countOfMinutes $(( timeoutSeconds / 60 )); }; the page has expired and" \
             bold "${ tildePath "${keyInfoFile}"; }" "is unchanged. Run" bold "valt key-info" "again when ready."
        return 0
    fi
    stopSpinner spinnerId " ${successCheckMark}"

    local secureDir; makeSecureTempDir secureDir
    local decrypted="${secureDir}/key-info.json"
    decryptKeyInfoDownload "${download}" "${pageKeys}" "${decrypted}"
    if isKeyInfoCancel "${decrypted}"; then
        rm -f "${decrypted}" "${download}" 2> /dev/null
        show "Cancelled;" bold "${ tildePath "${keyInfoFile}"; }" "is unchanged."
        return 0
    fi
    local before; before="${ keyInfoValues "${keyInfoFile}"; }"
    importKeyInfo "${decrypted}" "${keyInfoFile}"
    rm -f "${decrypted}"
    local changed=1
    [[ ${ keyInfoValues "${keyInfoFile}"; } == "${before}" ]] && changed=0
    if (( changed )); then
        show "Saved" bold "${ tildePath "${keyInfoFile}"; }" glue "."
    else
        show "No changes to" bold "${ tildePath "${keyInfoFile}"; }" glue "."
    fi

    # The download holds contact details, so remove it; security software may protect Downloads from deletion

    rm -f "${download}" 2> /dev/null
    if [[ -e ${download} ]]; then
        warn "Could not delete" bold "${ tildePath "${download}"; }" glue \
             ", perhaps because security software protects that folder. It is encrypted with a key that is now gone," \
             "so it is useless to anyone; delete it whenever convenient."
    fi
    (( changed )) && offerPaperKeyRegeneration # the paper key is only out of date if the key info changed
    return 0
}

# Outputs a number of minutes, e.g. '1 minute', '60 minutes' (less than one is shown as seconds).

_countOfMinutes() {
    local minutes=$1
    if (( minutes == 1 )); then echo "1 minute"; elif (( minutes > 1 )); then echo "${minutes} minutes"
    else echo "a few seconds"; fi
}

# Removes the key info page's temp dir (an exit handler, so that it also happens on Ctrl-C).

removeKeyInfoPageDir() {
    [[ -n ${_keyInfoPageDir:-} ]] && rm -rf "${_keyInfoPageDir}"
    return 0
}

# Sets the named vars to the editor command, from $VISUAL, else $EDITOR, else vi, and its name (for messages). The
# command is run by the shell, as git does, so it may hold arguments and quoted paths. Editors that open their own
# window, e.g. IntelliJ's idea or VS Code's code, return at once unless told to wait, so their wait option is added if
# missing.

editorCommand() {
    local -n commandRef=$1
    local -n nameRef=$2
    commandRef="${VISUAL:-${EDITOR:-vi}}"
    local -a words; mapfile -t words < <(sh -c "set -- ${commandRef}; printf '%s\n' \"\$@\"" 2> /dev/null)
    nameRef="${words[0]:-${commandRef}}"
    nameRef="${nameRef##*/}"
    local wait=''
    case ${nameRef} in
        idea | pycharm | webstorm | goland | clion | rubymine | phpstorm | rider | rustrover) wait='--wait' ;;
        code | code-insiders | codium | cursor | windsurf | zed) wait='--wait' ;;
        subl | mate) wait='-w' ;;
    esac
    [[ -z ${wait} ]] || memberOf --wait words || memberOf -w words || commandRef+=" ${wait}"
    return 0
}

# Runs an editor command (see editorCommand) on a file. An editor with its own window that is not on editorCommand's
# list returns at once, before the file is edited: if it returns within a few seconds and the file is unchanged, asks
# the user to say when they have saved it. Fails if they choose to discard their changes.

runEditor() {
    local file="$1" command="$2" name="$3"
    local before="${file}.before" started=${EPOCHSECONDS}
    cp "${file}" "${before}" || fail
    sh -c "${command}"' "$@"' "${name}" "${file}" || fail "could not run ${command}"
    local quick=0
    (( EPOCHSECONDS - started < 3 )) && cmp -s "${file}" "${before}" && quick=1
    rm -f "${before}"
    (( quick )) || return 0

    if (( ! _editorWaitHintShown )); then
        show nl bold "${name}" "returned at once, so it is probably editing the file in its own window."
        show "To have valt wait for it to close the file instead, add its wait option to" bold "VISUAL" glue \
             ", e.g." bold "${name} --wait" glue "."
        declare -g _editorWaitHintShown=1
    fi
    local -a doneChoices=("Done: I saved it" "Discard changes")
    local doneIndex result
    echo
    while true; do # editing takes a while, so ask again on a timeout; ESC discards
        choose "Edit and save the file, then:" doneChoices doneIndex false 0 0 0 3600 && break
        result=$?
        (( result == 124 )) || { doneIndex=1; break; }
    done
    (( doneIndex == 0 ))
}

# Edits the key info file in the user's editor, for when there is no browser to show the key info page on (e.g. over
# ssh) or --edit was given: a draft in secure temp storage is edited until it is complete, or the user saves it
# incomplete or discards it, then replaces the key info file if it changed.

editKeyInfo() {
    local keyInfoFile="$1"
    [[ -t 0 && -t 1 ]] || fail "editing the key info needs a terminal; or edit ${ tildePath "${keyInfoFile}"; } by hand"
    require 'rayvn/prompt'
    local editor editorName; editorCommand editor editorName
    local secureDir; makeSecureTempDir secureDir
    local draft="${secureDir}/key-info.json"
    newKeyInfoDraft "${keyInfoFile}" "${draft}"

    if ! canOpenUrls; then
        show nl "There is no browser here to show the key info page on (e.g. over ssh), so edit the file instead."
        show "First, the essentials. The full guide is at" blue "${valtGuideUrl}" nl
        printList "${ show "Your" bold "private key" "decrypts your files. It is itself encrypted with your" \
                         bold "passphrase" glue ", so both are needed."; }" \
                  "${ show "The" bold "paper key" "is a printed backup of it, with instructions and the people who can help."; }" \
                  "${ show "Write the passphrase on the paper key or, more securely, keep it elsewhere and say where in the" \
                         "notes."; }" \
                  "${ show "If the passphrase is lost, the files" bold "cannot be recovered" glue ", by anyone."; }"
    fi
    show nl "Your key info is JSON. Replace each" bold "<placeholder>" "with yours: any left are ignored, as are ways" \
         "and people left empty." nl "A way's type is phone, email, social or address; add" bold '"preferred": true' \
         "to the one to try first."
    local -a problems choices=("Edit again" "Save it incomplete" "Discard changes")
    local choiceIndex checked="${secureDir}/checked.json"
    while true; do
        runEditor "${draft}" "${editor}" "${editorName}" || { show "Discarded;" bold "${ tildePath "${keyInfoFile}"; }" "is unchanged."; return 0; }

        # Check a tidied copy, so that editing again still shows the placeholders

        cp "${draft}" "${checked}" || fail
        tidyKeyInfoDraft "${checked}"
        mapfile -t problems < <(keyInfoProblems "${checked}")
        (( ${#problems[@]} )) || break
        show nl "Your key info still needs:" nl
        printList "${problems[@]}"
        echo
        choose "What next?" choices choiceIndex || choiceIndex=2
        case ${choiceIndex} in
            0) ;;
            1) jq -e . "${checked}" > /dev/null 2>&1 && break
               warn "It is not valid JSON, so cannot be saved; edit it again or discard it." ;;
            *) show "Discarded;" bold "${ tildePath "${keyInfoFile}"; }" "is unchanged."; return 0 ;;
        esac
    done
    mv "${checked}" "${draft}" || fail

    if [[ ${ keyInfoValues "${draft}"; } == "${ keyInfoValues "${keyInfoFile}"; }" ]]; then
        show "No changes to" bold "${ tildePath "${keyInfoFile}"; }" glue "."
        return 0
    fi
    local temp="${keyInfoFile}.new"
    jq . "${draft}" > "${temp}" && chmod 600 "${temp}" && mv "${temp}" "${keyInfoFile}" \
        || fail "could not write ${keyInfoFile}"
    show "Saved" bold "${ tildePath "${keyInfoFile}"; }" glue "."
    (( ${#problems[@]} )) || offerPaperKeyRegeneration # only once complete
}

# Offers to regenerate the default key's paper key from the new key info (only on a terminal); otherwise shows how.

offerPaperKeyRegeneration() {
    local keyFile; keyFile="${ defaultValtKeyFile; }"
    [[ -f ${keyFile} ]] || return 0
    local command; command="${ paperKeyCommand "${keyFile}"; }"
    [[ -n ${_opts['key-info']} ]] && command+=" -k ${ tildePath "${_opts['key-info']}"; }"
    if [[ -t 0 && -t 1 ]]; then
        require 'rayvn/prompt'
        local choiceIndex=1
        echo
        confirm "Regenerate the paper key for ${ tildePath "${keyFile}"; } now?" yes no choiceIndex
        if (( choiceIndex == 0 )); then
            generatePaperKey "${keyFile}"
            openPaperKey "${keyFile}"
            return 0
        fi
    fi
    echo
    show "To regenerate the paper key, run:" bold blue "${command}"
}

# Explains how to generate the paper key for privateKeyFile once the key info is complete.

showPaperKeyDeferred() {
    local privateKeyFile="$1"
    local command; command=("${ paperKeyCommand "${privateKeyFile}"; }")
    [[ -n ${_opts['key-info']} ]] && command+=(-k "${ tildePath "${_opts['key-info']}"; }")
    [[ -n ${_opts['template']} ]] && command+=(-t "${ tildePath "${_opts['template']}"; }")
    [[ -n ${_opts['style']} ]] && command+=(-c "${ tildePath "${_opts['style']}"; }")

    echo
    show bold yellow "Paper key not generated:" "your key info is not complete yet."
    echo
    show "Your keys are ready to use now. Fill in your key info with" bold blue "valt key-info" glue \
         ", then generate the paper key with:"
    echo
    show "    " bold blue "${command[*]}"
}

source rayvn.up 'rayvn/core' 'valt/keys' || exit
main "$@"
