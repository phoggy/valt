#!/usr/bin/env rayvn-bash
# shellcheck disable=SC2155

usage() {
    echo
    show bold "Public key encryption for files and directories, using" cyan "age" "(see" blue "${ageProjectUrl}" glue ")."
    echo
    show "Usage:" bold blue "${scriptName}" "[OPTIONS]" italic "COMMAND"
    echo
    echo "Commands"
    echo
    echo "    keys             Create a key pair with an encrypted private key and a paper key as backup."
    echo "    paper            Create a backup paper key and documentation for an existing key pair."
    echo "    archive          Create a secure archive from one or more files or directories, or extract files from one."
    echo "    passphrase       Generate and/or evaluate passphrase strength."
    echo "    password         Generate and/or evaluate password strength."
    echo "    pwned            Check whether a password/phrase appears in the HaveIBeenPwned breach database."
    echo
    show "Run" bold blue "${scriptName}" italic "COMMAND" bold blue "--help" "for more information on a command."
    echo
    echo "Options"
    echo
    showCommonOptions 21
    echo
    bye "${@}"
}

main() {
    init "${@}"
    "${commandHandler}"
}

init() {
    declare -grx ageProjectUrl='https://github.com/filosottile/age'
    declare -grx valtBinDir="${0%/*}"
    declare -grx valtConfigDir="${ configDirPath; }"
    declare -grx valtProjectUrl='https://github.com/phoggy/valt'

    declare -gAr cliSpec=(
        ['pass']="newPassphrase(--words|-w:+int --separator|-s:str --count|-c:+int)"
        ['passphrase']="newPassphrase(--words|-w:+int --separator|-s:str --count|-c:+int)"
        ['password']="newPassword(--length|-l:+int)"
#        ['pwned']=checkPass"newPassword"
#        ['keys']="newKeys"
#        ['keygen']="newKeys"
#        ['paper']="newPaperKeys"
#        ['paper-keys']="newPaperKeys"
#        ['archive']="newArchive"
    )
    local argSpec=( "--name|-n:str" "--force|-f"  "--count:+int"  "bool" '*' )

    generateParser valt argSpec
    echo; echo; echo
    generateParser valt cliSpec
    exit





    parseCommand valt commandHandlers 0 "$@"
    debugVar commandHandler commandOptions
    exit
}

# ---- newPassphrase -----

newPassphrase() {
    local words="${commandOptions['words']:-5}"
    local separator="${commandOptions['separator']:-" "}"
    local count="${commandOptions['count']:-1}"
debug "newPassphrase(words=${words}, separator='${separator}', count=${count})"
}

newPassphraseUsage() {
    echo "valt passphrase [--words N] [--separator SEP] [--count N]"
    echo
    echo "  Generate one or more new passphrases."
    echo
    echo "  --words N        The number of words in the passphrase (default: 5)."
    echo "  --separator SEP  The separator string between words (default: ' ')."
    echo "  --count N        The number of passphrases to generate (default: 1)."
}

# ---- newPassword -----

newPassword() {
    echo newPassword
}

newPasswordUsage() {
    echo newPasswordUsage
}

# ---- checkPass -----

checkPass() {
    echo checkPass
}

checkPassUsage() {
    echo checkPassUsage
}

# ---- newPaperKeys -----

newPaperKeys() {
    echo newPaperKeys
}

newPaperKeysUsage() {
    echo newPaperKeysUsage
}

# ---- newKeys -----

newArchive() {
    echo newArchive
}

newArchiveUsage() {
    echo newArchiveUsage
}




