}

decryptCmdUsage() {
    echo
    show bold "Decrypt an encrypted file, or verify and extract a secure archive (.valt). You will be prompted for"
    show bold "the passphrase that protects the private key."
    echo
    show "Usage:" bold blue "valt decrypt" "FILE [--force] [--identity IDENTITY] [--output OUTPUT]"
    echo
    option "FILE" "The encrypted file (.age) or secure archive (.valt)." 29
    option "--identity, -i IDENTITY" "The private key file (default: valt.key in the valt config directory)." 29
    option "--output, -o OUTPUT" "For a file, the output file ('-' for standard output; default: FILE" 29
    option "" "without .age). For an archive, the existing directory to extract into" 29
    option "" "(default: the current directory)." 29
    option "--force, -f" "Overwrite an existing output file." 29
    option "--help, -h" "Print this help message." 29
    echo
    echo "If a signature file (FILE.minisig) is present, it is verified before decrypting and decryption"
    echo "stops if it does not match. A warning is shown if there is no signature. Archives always contain"
    echo "signatures, which are verified before extracting."
    declare -F decryptCmdUsageExtra > /dev/null && decryptCmdUsageExtra
    bye "$@"
}

parseEncryptArgs() {
    declare -g _optListRecipient=()
    declare -g _optListRecipientFile=()
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=encryptCmdUsage
    local _argIndex=0 _value
    while (( $# > 0 )); do
        case "$1" in
            --armor | -a) _opts+=(['armor']="1"); shift ;;
            --armor=*) fail "--armor does not accept a value" ;;
            --delete) _opts+=(['delete']="1"); shift ;;
            --delete=*) fail "--delete does not accept a value" ;;
            --force | -f) _opts+=(['force']="1"); shift ;;
            --force=*) fail "--force does not accept a value" ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --identity | -i) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--armor|--output|--recipient|--identity|--recipient-file|-r|-f|-a|-o|-h|-i|-R|--no-sign|--help|--delete|--no-self|--force|--verify)$ ) ]] && fail "missing value for --identity"; assertFile "$2"; _opts+=(['identity']="$2"); shift 2 ;;
            --identity=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --identity"; assertFile "${_value}"; _opts+=(['identity']="${_value}"); shift ;;
            --no-self) _opts+=(['no-self']="1"); shift ;;
            --no-self=*) fail "--no-self does not accept a value" ;;
            --no-sign) _opts+=(['no-sign']="1"); shift ;;
            --no-sign=*) fail "--no-sign does not accept a value" ;;
            --output | -o) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--armor|--output|--recipient|--identity|--recipient-file|-r|-f|-a|-o|-h|-i|-R|--no-sign|--help|--delete|--no-self|--force|--verify)$ ) ]] && fail "missing value for --output"; _opts+=(['output']="$2"); shift 2 ;;
            --output=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --output"; _opts+=(['output']="${_value}"); shift ;;
            --recipient | -r) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--armor|--output|--recipient|--identity|--recipient-file|-r|-f|-a|-o|-h|-i|-R|--no-sign|--help|--delete|--no-self|--force|--verify)$ ) ]] && fail "missing value for --recipient"; _optListRecipient+=("$2"); _opts+=(['recipient']="1"); shift 2 ;;
            --recipient=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --recipient"; _optListRecipient+=("${_value}"); _opts+=(['recipient']="1"); shift ;;
            --recipient-file | -R) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--armor|--output|--recipient|--identity|--recipient-file|-r|-f|-a|-o|-h|-i|-R|--no-sign|--help|--delete|--no-self|--force|--verify)$ ) ]] && fail "missing value for --recipient-file"; assertFile "$2"; _optListRecipientFile+=("$2"); _opts+=(['recipient-file']="1"); shift 2 ;;
            --recipient-file=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --recipient-file"; assertFile "${_value}"; _optListRecipientFile+=("${_value}"); _opts+=(['recipient-file']="1"); shift ;;
            --verify) _opts+=(['verify']="1"); shift ;;
            --verify=*) fail "--verify does not accept a value" ;;
            --) shift
                while (( $# > 0 )); do
                    (( _argIndex == 0 )) || unknownArg "$1"
                    _args+=("$1"); (( _argIndex++ )); shift
                done ;;
            *) (( _argIndex == 0 )) || unknownArg "$1"; _args+=("$1"); (( _argIndex++ )); shift ;;
        esac
    done
    (( _opts['help'] || _argIndex >= 1 )) || { local -a _missingArgs=("FILE"); _missingArgs=("${_missingArgs[@]:${_argIndex}}"); (( ${#_missingArgs[@]} == 1 )) && fail "missing required argument: ${_missingArgs[0]}" || fail "missing required arguments: ${_missingArgs[*]}"; }
    declare -g _failHandler="${_prevFailHandler}"
}

encryptCmdUsage() {
    echo
    show bold "Encrypt a single file to FILE.age and sign it with your private key (FILE.age.minisig). Your own"
    show bold "public key is always a recipient unless --no-self is given. Use 'valt archive create' for"
    show bold "directories or multiple files."
    echo
    show "Usage:" bold blue "valt encrypt" "FILE [--armor] [--delete] [--force] [--identity IDENTITY] [--no-self]"
    echo "                    [--no-sign] [--output OUTPUT] [--recipient RECIPIENT]... [--recipient-file"
    echo "                    RECIPIENT-FILE]... [--verify]"
    echo
    option "FILE" "The file to encrypt." 41
    option "--identity, -i IDENTITY" "Your private key file, used to sign and to find your public" 41
    option "" "key (the .pub file next to it); default: valt.key in the" 41
    option "" "valt config directory." 41
    option "--recipient, -r RECIPIENT" "Also encrypt to this recipient (an age public key). Can be" 41
    option "" "repeated." 41
    option "--recipient-file, -R RECIPIENT-FILE" "Also encrypt to the recipient(s) in this file, e.g. a valt" 41
    option "" ".pub file. Can be repeated." 41
    option "--no-self" "Do not include your own public key as a recipient." 41
    option "--no-sign" "Do not sign the encrypted file." 41
    option "--armor, -a" "Write PEM encoded (text) output." 41
    option "--output, -o OUTPUT" "The output file ('-' for standard output, which requires" 41
    option "" "--no-sign); default: FILE.age." 41
    option "--force, -f" "Overwrite an existing output file." 41
    option "--verify" "Decrypt the result with your private key and confirm it" 41
    option "" "matches FILE." 41
    option "--delete" "Delete FILE after a successful --verify. This is an" 41
    option "" "ordinary delete, not a secure erase." 41
    option "--help, -h" "Print this help message." 41
    declare -F encryptCmdUsageExtra > /dev/null && encryptCmdUsageExtra
    bye "$@"
}

parseKeysArgs() {
    _opts+=(['name']="valt")
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=keysCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --css | -c) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--output-dir|--no-verify|--template|-t|-q|-f|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --css"; assertFile "$2"; _opts+=(['css']="$2"); shift 2 ;;
            --css=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --css"; assertFile "${_value}"; _opts+=(['css']="${_value}"); shift ;;
            --force | -f) _opts+=(['force']="1"); shift ;;
            --force=*) fail "--force does not accept a value" ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --key-info | -k) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--output-dir|--no-verify|--template|-t|-q|-f|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --key-info"; assertFile "$2"; _opts+=(['key-info']="$2"); shift 2 ;;
            --key-info=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --key-info"; assertFile "${_value}"; _opts+=(['key-info']="${_value}"); shift ;;
            --name | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--output-dir|--no-verify|--template|-t|-q|-f|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --name"; _opts+=(['name']="$2"); shift 2 ;;
            --name=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --name"; _opts+=(['name']="${_value}"); shift ;;
            --no-advice) _opts+=(['no-advice']="1"); shift ;;
            --no-advice=*) fail "--no-advice does not accept a value" ;;
            --no-pdf) _opts+=(['no-pdf']="1"); shift ;;
            --no-pdf=*) fail "--no-pdf does not accept a value" ;;
            --no-verify) _opts+=(['no-verify']="1"); shift ;;
            --no-verify=*) fail "--no-verify does not accept a value" ;;
            --output-dir | -o) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--output-dir|--no-verify|--template|-t|-q|-f|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --output-dir"; assertDirectory "$2"; _opts+=(['output-dir']="$2"); shift 2 ;;
            --output-dir=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --output-dir"; assertDirectory "${_value}"; _opts+=(['output-dir']="${_value}"); shift ;;
            --quick | -q) _opts+=(['quick']="1"); shift ;;
            --quick=*) fail "--quick does not accept a value" ;;
            --template | -t) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--output-dir|--no-verify|--template|-t|-q|-f|-c|-n|-o|-k|-h|--no-advice|--key-info|--name|--help|--no-pdf|--force|--quick)$ ) ]] && fail "missing value for --template"; assertFile "$2"; _opts+=(['template']="$2"); shift 2 ;;
            --template=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --template"; assertFile "${_value}"; _opts+=(['template']="${_value}"); shift ;;
            --) shift; (( $# == 0 )) || unknownArg "$1" ;;
            *) unknownArg "$1" ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

keysCmdUsage() {
    echo
    show bold "Generate an age key pair, with the private key encrypted by a passphrase, plus a PDF paper key as"
    show bold "backup documentation. A strong passphrase is highly encouraged; advice and an opportunity to"
    show bold "generate one will be offered."
    echo
    show "Usage:" bold blue "valt keys" "[--css CSS] [--force] [--key-info KEY-INFO] [--name NAME] [--no-advice] [--no-pdf]"
    echo "                 [--no-verify] [--output-dir OUTPUT-DIR] [--quick] [--template TEMPLATE]"
    echo
    option "--name, -n NAME" "Name to use for key files, e.g. bob -> bob.pub, bob.key. (default:" 33
    option "" "valt)" 33
    option "--output-dir, -o OUTPUT-DIR" "Directory for the key files (default: the valt config directory)." 33
    option "--force, -f" "Overwrite existing key files." 33
    option "--no-verify" "Do not verify keys." 33
    option "--no-advice" "Do not show passphrase advice." 33
    option "--quick, -q" "Same as --no-advice --no-verify." 33
    option "--no-pdf" "Do not generate the paper key PDF." 33
    option "--key-info, -k KEY-INFO" "Key info file to use instead of the default for PDF generation." 33
    option "--template, -t TEMPLATE" "HTML template file to use instead of the default for PDF" 33
    option "" "generation." 33
    option "--css, -c CSS" "CSS file with style overrides to apply for PDF generation." 33
    option "--help, -h" "Print this help message." 33
    echo
    echo "The PDF contains your keys, also in encrypted form, to serve as a backup for you and/or your"
    echo "successors, along with detailed usage instructions. Keys are represented as a QR code and again in"
    echo "a text format (often called \"paper keys\"). Content is personalized from a key.info file; if it has"
    echo "not been completed, the PDF is skipped and can be generated later with 'valt paper'."
    echo
    echo "Please ensure that you print at least one copy of the PDF file and write your passphrase on the"
    echo "last page (or leave the passphrase blank and add instructions on where to find it in the Notes"
    echo "section), then store copies in secure locations, e.g. safe deposit box/fire safe and/or with"
    echo "trusted people!"
    echo
    echo "Document Customization"
    echo
    echo "The HTML template can be changed from the default and CSS style overrides can be applied. The"
    echo "default template and primary CSS file can be found in the valt 'etc' directory. Template"
    echo "substitutions are performed with variables defined in the key.info file. Note that keys prefixed"
    echo "with an underscore are reserved for system use."
    declare -F keysCmdUsageExtra > /dev/null && keysCmdUsageExtra
    bye "$@"
}

parsePaperArgs() {
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=paperCmdUsage
    local _argIndex=0 _value
    while (( $# > 0 )); do
        case "$1" in
            --css | -c) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --css"; assertFile "$2"; _opts+=(['css']="$2"); shift 2 ;;
            --css=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --css"; assertFile "${_value}"; _opts+=(['css']="${_value}"); shift ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --key-info | -k) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --key-info"; assertFile "$2"; _opts+=(['key-info']="$2"); shift 2 ;;
            --key-info=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --key-info"; assertFile "${_value}"; _opts+=(['key-info']="${_value}"); shift ;;
            --name | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --name"; _opts+=(['name']="$2"); shift 2 ;;
            --name=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --name"; _opts+=(['name']="${_value}"); shift ;;
            --template | -t) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--css|--template|-t|-c|-n|-k|-h|--key-info|--name|--help)$ ) ]] && fail "missing value for --template"; assertFile "$2"; _opts+=(['template']="$2"); shift 2 ;;
            --template=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --template"; assertFile "${_value}"; _opts+=(['template']="${_value}"); shift ;;
            --) shift
                while (( $# > 0 )); do
                    (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"
                    _args+=("$1"); (( _argIndex++ )); shift
                done ;;
            *) (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"; _args+=("$1"); (( _argIndex++ )); shift ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

paperCmdUsage() {
    echo
    show bold "Generate the paper key PDF for an existing key pair, personalized from the key.info file. The PDF is"
    show bold "written next to the key and replaces any existing one, so this can be re-run whenever key.info"
    show bold "changes. The passphrase is not required, since the private key is included in its encrypted form."
    echo
    show "Usage:" bold blue "valt paper" "[KEY_FILE] [--css CSS] [--key-info KEY-INFO] [--name NAME] [--template TEMPLATE]"
    echo
    option "KEY_FILE" "The private key file (default: valt.key in the valt config directory)." 29
    option "--name, -n NAME" "Use the NAME.key file in the valt config directory, e.g. bob ->" 29
    option "" "bob.key." 29
    option "--key-info, -k KEY-INFO" "Key info file to use instead of the default." 29
    option "--template, -t TEMPLATE" "HTML template file to use instead of the default." 29
    option "--css, -c CSS" "CSS file with style overrides to apply." 29
    option "--help, -h" "Print this help message." 29
    echo
    echo "Please ensure that you print at least one copy of the PDF file and write your passphrase on the"
    echo "last page (or leave the passphrase blank and add instructions on where to find it in the Notes"
    echo "section). See 'valt keys --help' for document customization details."
    declare -F paperCmdUsageExtra > /dev/null && paperCmdUsageExtra
    bye "$@"
}

ARGS_PARSER_END="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 🚫 END generated code: DO NOT EDIT 🚫 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

SECTION="--+-+-----+-++(-++(---++++(---+( COMMANDS )+---)++++---)++-)++-+------+-+--"

keysCmd() {
    require 'valt/paper-keys'
    local name="${_opts['name']}"
    assertValidFileName "${name}"
    local outputDir="${_opts['output-dir']:-${valtConfigDir}}"
    local publicKeyFile="${outputDir}/${name}.${valtPublicKeySuffix}"
    local privateKeyFile="${outputDir}/${name}.${valtPrivateKeySuffix}"
    local verify=1
    (( _opts['no-verify'] || _opts['quick'] )) && verify=0
    (( _opts['no-advice'] || _opts['quick'] )) && declare -gx skipKeyPassphraseAdvice=1

    if (( _opts['force'] )); then
        rm -f "${publicKeyFile}" "${privateKeyFile}"
    else
        assertFileDoesNotExist "${privateKeyFile}"
        assertFileDoesNotExist "${publicKeyFile}"
    fi

    createKeys "${name}" "${outputDir}" "${publicKeyFile}" "${privateKeyFile}" ${verify}

    (( _opts['no-pdf'] )) && return 0
    if isKeyInfoComplete "${_opts['key-info']}"; then
        generatePaperKey "${privateKeyFile}"
    else
        showPaperKeyDeferred "${privateKeyFile}"
    fi
}

paperCmd() {
    require 'valt/paper-keys'
    local keyFile="${_args[0]:-}"
    if [[ -n ${_opts['name']} ]]; then
        [[ -z ${keyFile} ]] || paperCmdUsage "Specify either --name or KEY_FILE, not both."
        assertValidFileName "${_opts['name']}"
        keyFile="${valtConfigDir}/${_opts['name']}.${valtPrivateKeySuffix}"
    fi
    [[ -n ${keyFile} ]] || keyFile="${valtConfigDir}/valt.${valtPrivateKeySuffix}"
    assertFile "${keyFile}" "private key file"
    generatePaperKey "${keyFile}"
}

decryptCmd() {
    require 'valt/paper-keys'
    local file="${_args[0]}"
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"

    if [[ ${file} == *.valt ]]; then
        extractArchive "${file}" "${keyFile}" "${_opts['output']:-${PWD}}"
    else
        decryptFile "${file}" "${keyFile}"
    fi
    remindPaperKey "${keyFile}"
}

encryptCmd() {
    require 'valt/paper-keys'
    local file="${_args[0]}"
    [[ -d ${file} ]] && encryptCmdUsage "${file} is a directory; use 'valt archive create' for directories and multiple files."
    assertFile "${file}"
    (( _opts['delete'] && ! _opts['verify'] )) && encryptCmdUsage "--delete requires --verify."
    (( _opts['verify'] && _opts['no-self'] )) && encryptCmdUsage "--verify cannot be combined with --no-self, since your key could not decrypt the file."

    local output="${_opts['output']:-${file}.${_ageFileExtension}}"
    local sign=1
    (( _opts['no-sign'] )) && sign=0
    if [[ ${output} == '-' ]]; then
        (( sign )) && encryptCmdUsage "Signing requires an output file; use --no-sign with '--output -'."
        (( _opts['verify'] )) && encryptCmdUsage "--verify requires an output file."
    else
        assertCanWrite "${output}"
        (( sign )) && assertCanWrite "${output}.${_signatureFileSuffix}"
    fi

    local keyFile; keyFile="${ identityKeyFile; }"
    local -a recipientArgs=()
    addRecipientArgs recipientArgs "${keyFile}" encryptCmdUsage

    # Signing and verification both decrypt the private key, so ask for its passphrase once.
    # Shadow with a local so that it goes out of scope when we return.

    local rayvnTest_ValtKeyPassphrase="${rayvnTest_ValtKeyPassphrase}"
    if (( sign || _opts['verify'] )); then
        assertFile "${keyFile}" "private key file"
        _prepareKey "${keyFile}"
    fi

    local -a encryptArgs=("${file}" "${recipientArgs[@]}")
    (( _opts['armor'] )) && encryptArgs+=(--armor)
    if [[ ${output} == '-' ]]; then
        encrypt "${encryptArgs[@]}" || fail
        return 0
    fi
    encrypt "${encryptArgs[@]}" -o "${output}" || fail
    show "Encrypted" cyan "${ tildePath "${file}"; }" "to" bold "${ tildePath "${output}"; }"

    if (( sign )); then
        signFile "${keyFile}" "${output}"
        show "Signed" bold "${ tildePath "${output}"; }" "with" cyan "${ tildePath "${keyFile}"; }"
    fi
    (( _opts['verify'] )) && verifyEncryptedFile "${file}" "${output}" "${keyFile}"
    if (( _opts['delete'] )); then
        rm "${file}" || fail
        show "Deleted" bold "${ tildePath "${file}"; }"
    fi
    if (( sign || _opts['verify'] )); then
        remindPaperKey "${keyFile}"
    fi
}

archiveCreateCmd() {
    require 'valt/paper-keys' 'valt/archive'
    (( ${#_args[@]} )) || archiveCreateCmdUsage "missing required argument: INPUT..."
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    local -a recipientArgs=()
    addRecipientArgs recipientArgs "${keyFile}" archiveCreateCmdUsage

    local -a args=("${_args[@]}" -i "${keyFile}" "${recipientArgs[@]}")
    [[ -n ${_opts['name']} ]] && args+=(-n "${_opts['name']}")
    [[ -n ${_opts['zone']} ]] && args+=(-z "${_opts['zone']}")
    [[ -n ${_opts['user-text']} ]] && args+=(-u "${_opts['user-text']}")
    [[ -n ${_opts['output-dir']} ]] && args+=(-o "${_opts['output-dir']}")
    (( _opts['force'] )) && args+=(-f)

    local archive; archive="${ newSecureArchive "${args[@]}"; }" || fail
    show "Created secure archive" bold "${ tildePath "${archive}"; }"
    show "Public companion (safe to share):" cyan "${ tildePath "${archive}.pub"; }"
    remindPaperKey "${keyFile}"
}

archiveVerifyCmd() {
    require 'valt/paper-keys' 'valt/archive'
    local archive="${_args[0]}"
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    show "Verifying secure archive" cyan "${ tildePath "${archive}"; }"
    verifySecureArchive "${archive}" -i "${keyFile}" || fail
    show "Signatures verified for" bold "${ tildePath "${archive}"; }"
    remindPaperKey "${keyFile}"
}

archiveExtractCmd() {
    require 'valt/paper-keys'
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    extractArchive "${_args[0]}" "${keyFile}" "${_opts['output-dir']:-${PWD}}"
    remindPaperKey "${keyFile}"
}

SECTION="--+-+-----+-++(-++(---++++(---+( SHARED FUNCTIONS )+---)++++---)++-)++-+------+-+--"

createKeys() {
    local name="$1" outputDir="$2" publicKeyFile="$3" privateKeyFile="$4" verify=$5
    echo
    header -u "Generating Keys"

    newValtKeys "${name}" "${outputDir}" || fail
    echo
    show "Public key (aka 'recipient') file:" cyan "${ tildePath "${publicKeyFile}"; }" "(includes public signing key)"
    show "Private key (aka 'identity') file:" cyan "${ tildePath "${privateKeyFile}"; }" "(includes public key and both signing keys)"

    if (( verify )); then
        header 2 "Verifying keys"
        verifyValtKeys "${publicKeyFile}" "${privateKeyFile}"
        echo
        show bold "Verified" glue ":"
        echo
        show "  · A file encrypted with" cyan "${name}.pub" "decrypts with passphrase and the" cyan "${name}.key" "private key. ${successCheckMark}"
        show "  · A signature created with" cyan "${name}.key" "for the encrypted file matches. ${successCheckMark} "
    fi
}

# Generates the paper key for privateKeyFile using the key-info, template and css options.

generatePaperKey() {
    local privateKeyFile keyInfoFile='' cssFile='' templateFile=''

    # newPaperKey changes to a work directory, so resolve all paths first.

    setFileVar privateKeyFile "$1" "private key file"
    [[ -n ${_opts['key-info']} ]] && setFileVar keyInfoFile "${_opts['key-info']}" "key info file"
    [[ -n ${_opts['css']} ]] && setFileVar cssFile "${_opts['css']}" "css file"
    [[ -n ${_opts['template']} ]] && setFileVar templateFile "${_opts['template']}" "template file"

    local existingPdf; existingPdf="${ _paperKeyFile "${privateKeyFile}"; }"
    local replacing=0
    [[ -f "${existingPdf}" ]] && replacing=1

    echo
    header -u "Generating Paper Key"

    local paperKeyFile
    newPaperKey "${privateKeyFile}" paperKeyFile "${keyInfoFile}" "${cssFile}" "${templateFile}"

    echo
    show "Paper key file:" cyan "${ tildePath "${paperKeyFile}"; }"
    echo
    show "Print at least one copy," italic "write your passphrase" "on the last page, and" \
         bold "store copies in secure locations" glue "."
    if (( replacing )); then
        echo
        show bold yellow "The previous paper key was replaced." "Destroy any printed copies of it so that outdated" \
             "contact information is not relied upon."
    fi
}

# Decrypts a single file, verifying its signature first if present.

decryptFile() {
    local file="$1" keyFile="$2"
    local output="${_opts['output']}"
    if [[ -z ${output} ]]; then
        [[ ${file} == *.${_ageFileExtension} ]] \
            || decryptCmdUsage "Cannot derive an output file name from '${file}'; use --output."
        output="${file%.${_ageFileExtension}}"
    fi
    [[ ${output} == '-' ]] || assertCanWrite "${output}"

    verifySignatureIfPresent "${file}" "${keyFile}"

    if [[ ${output} == '-' ]]; then
        decrypt -i "${keyFile}" "${file}" || fail
    else
        decrypt -i "${keyFile}" -o "${output}" "${file}" || fail
        show "Decrypted" cyan "${ tildePath "${file}"; }" "to" bold "${ tildePath "${output}"; }"
    fi
}

# Verifies a single file's detached signature, failing on mismatch and warning if it cannot be checked.

verifySignatureIfPresent() {
    local file="$1" keyFile="$2"
    local signatureFile="${file}.${_signatureFileSuffix}"
    local path; path="${ tildePath "${file}"; }"
    if [[ ! -f "${signatureFile}" ]]; then
        warn "No signature found for" bold "${path}" glue "; its authenticity cannot be verified."
    elif ! command -v minisign &> /dev/null; then
        warn "minisign is not installed; the signature for" bold "${path}" "was not verified."
    else
        ( verifyFileSignature "${keyFile}" "${file}" "${signatureFile}" ) &> /dev/null \
            || fail "Signature verification failed for ${path}: it may have been modified, or was signed with a different key."
    fi
}

# Verifies and extracts a secure archive into destDir.

extractArchive() {
    local file="$1" keyFile="$2" destDir="$3"
    require 'valt/archive'
    show "Verifying and extracting secure archive" cyan "${ tildePath "${file}"; }"
    extractSecureArchive "${file}" -i "${keyFile}" -o "${destDir}" || fail
    show "Extracted to" bold "${ tildePath "${destDir}"; }"
}

# Outputs the private key file from --identity, defaulting to valt.key in the valt config directory.

identityKeyFile() {
    echo "${_opts['identity']:-${valtConfigDir}/valt.${valtPrivateKeySuffix}}"
}

# Adds -r/-R recipient args from the --recipient, --recipient-file and --no-self options. Unless --no-self is
# given, the public key next to keyFile is included. Calls usageFunction if there would be no recipients.

addRecipientArgs() {
    local -n recipientArgsRef=$1
    local keyFile="$2" usageFunction="$3"
    if (( ! _opts['no-self'] )); then
        local publicKeyFile="${keyFile%.${valtPrivateKeySuffix}}.${valtPublicKeySuffix}"
        [[ -f "${publicKeyFile}" ]] || fail "No public key found at ${ tildePath "${publicKeyFile}"; }; create one with" \
                                            "'valt keys', or use --no-self with --recipient or --recipient-file."
        recipientArgsRef+=(-R "${publicKeyFile}")
    fi
    local recipient
    for recipient in "${_optListRecipient[@]}"; do recipientArgsRef+=(-r "${recipient}"); done
    for recipient in "${_optListRecipientFile[@]}"; do recipientArgsRef+=(-R "${recipient}"); done
    (( ${#recipientArgsRef[@]} )) || ${usageFunction} "--no-self requires at least one --recipient or --recipient-file."
}

# Fails if file exists, unless --force was given.

assertCanWrite() {
    [[ -e "$1" ]] || return 0
    (( _opts['force'] )) || fail "${ tildePath "$1"; } already exists; use --force to overwrite."
}

# Decrypts encryptedFile with keyFile and fails unless the result matches originalFile.

verifyEncryptedFile() {
    local originalFile="$1" encryptedFile="$2" keyFile="$3"
    local workDir; makeSecureTempDir workDir
    decrypt -i "${keyFile}" -o "${workDir}/decrypted" "${encryptedFile}" || fail
    local originalHash; originalHash="${ sha256sum < "${originalFile}"; }"
    local decryptedHash; decryptedHash="${ sha256sum < "${workDir}/decrypted"; }"
    [[ ${originalHash} == "${decryptedHash}" ]] \
        || fail "Verification failed: ${ tildePath "${encryptedFile}"; } does not decrypt to ${ tildePath "${originalFile}"; }."
    show "Verified" bold "${ tildePath "${encryptedFile}"; }" "decrypts to match" cyan "${ tildePath "${originalFile}"; }"
}

# Explains how to generate the paper key for privateKeyFile once key.info is complete.

showPaperKeyDeferred() {
    local privateKeyFile="$1"
    local infoFile; infoFile="${ tildePath "${_opts['key-info']:-${valtConfigDir}/key.info}"; }"
    local command; command=("${ paperKeyCommand "${privateKeyFile}"; }")
    [[ -n ${_opts['key-info']} ]] && command+=(-k "${ tildePath "${_opts['key-info']}"; }")
    [[ -n ${_opts['template']} ]] && command+=(-t "${ tildePath "${_opts['template']}"; }")
    [[ -n ${_opts['css']} ]] && command+=(-c "${ tildePath "${_opts['css']}"; }")

    echo
    show bold yellow "Paper key not generated:" "the" blue "${infoFile}" "file has not been completed."
    echo
    show "Your keys are ready to use now. When you have completed" blue "key.info" glue ", generate the paper key with:"
    echo
    show "    " bold blue "${command[*]}"
}

source rayvn.up 'rayvn/core' 'valt/keys' || exit
main "$@"
