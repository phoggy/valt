#!/usr/bin/env rayvn-bash
# shellcheck disable=SC2155
# shellcheck disable=SC2120

usage() {
    echo
    show bold "Public key encryption for files and archives, using" cyan "age" "(see" blue "https://github.com/filosottile/age" glue ")."
    echo
    show "Usage:" bold blue "${scriptName}" "COMMAND [OPTIONS]"
    echo
    echo "Commands"
    echo
    echo "    keys         Create a key pair with an encrypted private key and a paper key as backup."
    echo "    paper        Create or regenerate the paper key for an existing key pair."
    echo "    encrypt      Encrypt and sign a single file."
    echo "    decrypt      Decrypt a file, or verify and extract a secure archive."
    echo "    archive      Create, verify or extract a signed, encrypted archive of files and directories."
    echo "    verify       Verify a key pair, and optionally files encrypted or archived with it."
    echo "    default-key  Show or set the default private key file, used when no key is given."
    echo "    passphrase   Generate random passphrases."
    echo "    password     Generate random passwords."
    echo "    pass-check   Check a password or passphrase: its strength, and whether it is in a known breach."
    echo
    echo "Use COMMAND --help for additional details."
    echo
    echo "Options"
    echo
    showCommonOptions 21 true true valtEnvVars
    bye "$@"
}

main() {
    init
    parseCommand "$@"
}

init() {
    declare -gA _opts=()
    declare -ga _args=()
    declare -gAr valtEnvVars=(
        ['VALT_KEY_FILE']="The default private key file; overrides the 'valt default-key' setting."
    )
}

SECTION="--+-+-----+-++(-++(---++++(---+( ARGUMENT PARSING )+---)++++---)++-)++-+------+-+--"

# rayvn:cli cliSpec
declare -gA cliSpec=(
    # Generate an age key pair, with the private key encrypted by a passphrase, plus a PDF paper key as backup
    # documentation. A strong passphrase is highly encouraged; advice and an opportunity to generate one will be offered.
    #   --name        Name to use for key files, e.g. bob -> bob.pub, bob.key.
    #   --output-dir  Directory for the key files (default: the valt config directory).
    #   --force       Replace existing key files, once the new ones have been created.
    #   --allow-weak-passphrase  Accept a passphrase that fails the strength and breach check. Not recommended: the passphrase is all that protects the private key.
    #   --default     Make the new key the default key (see 'valt default-key') without asking. Otherwise you are asked, unless it already is the default.
    #   --no-verify   Do not verify keys.
    #   --no-advice   Do not show passphrase advice.
    #   --quick       Same as --no-advice --no-verify.
    #   --no-pdf      Do not generate the paper key PDF.
    #   --key-info    Key info file to use instead of the default for PDF generation.
    #   --template    HTML template file to use instead of the default for PDF generation.
    #   --css         CSS file with style overrides to apply for PDF generation.
    #
    # The PDF contains your keys, also in encrypted form, to serve as a backup for you and/or your
    # successors, along with detailed usage instructions. Keys are represented as a QR code and again in
    # a text format (often called "paper keys"). Content is personalized from a key.info file; if it has
    # not been completed, the PDF is skipped and can be generated later with 'valt paper'.
    #
    # The PDF is opened when done, so that you can check and print it. Please ensure that you print at
    # least one copy and write your passphrase on the last page (or leave the passphrase blank and add
    # instructions on where to find it in the Notes section), then store copies in secure locations,
    # e.g. safe deposit box/fire safe and/or with trusted people!
    #
    # Document Customization
    #
    # The HTML template can be changed from the default and CSS style overrides can be applied. The
    # default template and primary CSS file can be found in the valt 'etc' directory. Template
    # substitutions are performed with variables defined in the key.info file. Note that keys prefixed
    # with an underscore are reserved for system use.
    ['keys']='keys(--name|-n:str=valt --output-dir|-o:dir --force|-f --allow-weak-passphrase --default|-d --no-verify --no-advice --quick|-q --no-pdf --key-info|-k:file --template|-t:file --css|-c:file --help|-h)'

    # Generate the paper key PDF for an existing key pair, personalized from the key.info file. The PDF is written
    # next to the key and replaces any existing one, so this can be re-run whenever key.info changes. The passphrase
    # is not required, since the private key is included in its encrypted form.
    #   KEY_FILE    The private key file (default: the default key; see 'valt default-key').
    #   --name      Use the NAME.key file in the valt config directory, e.g. bob -> bob.key.
    #   --key-info  Key info file to use instead of the default.
    #   --template  HTML template file to use instead of the default.
    #   --css       CSS file with style overrides to apply.
    #
    # The PDF is opened when done, so that you can check and print it. Please ensure that you print at
    # least one copy and write your passphrase on the last page (or leave the passphrase blank and add
    # instructions on where to find it in the Notes section). See 'valt keys --help' for document
    # customization details.
    ['paper']='paper(file? --name|-n:str --key-info|-k:file --template|-t:file --css|-c:file --help|-h)'

    # Decrypt an encrypted file, or verify and extract a secure archive (.valt). You will be prompted
    # for the passphrase that protects the private key.
    #   FILE        The encrypted file (.age) or secure archive (.valt).
    #   --identity  The private key file (default: the default key; see 'valt default-key').
    #   --output    For a file, the output file ('-' for standard output; default: FILE without .age). For an archive, the existing directory to extract into (default: the current directory).
    #   --force     Overwrite an existing output file.
    #
    # If a signature file (FILE.minisig) is present, it is verified before decrypting and decryption
    # stops if it does not match. A warning is shown if there is no signature. Archives always contain
    # signatures, which are verified before extracting.
    ['decrypt']='decrypt(file --identity|-i:file --output|-o:str --force|-f --help|-h)'

    # Encrypt a single file to FILE.age and sign it with your private key (FILE.age.minisig). Your own
    # public key is always a recipient unless --no-self is given. Use 'valt archive create' for
    # directories or multiple files.
    #   FILE              The file to encrypt.
    #   --identity        Your private key file, used to sign and to find your public key (the .pub file next to it); default: the default key (see 'valt default-key').
    #   --recipient       Also encrypt to this recipient (an age public key). Can be repeated.
    #   --recipient-file  Also encrypt to the recipient(s) in this file, e.g. a valt .pub file. Can be repeated.
    #   --no-self         Do not include your own public key as a recipient.
    #   --no-sign         Do not sign the encrypted file.
    #   --armor           Write PEM encoded (text) output.
    #   --output          The output file ('-' for standard output, which requires --no-sign); default: FILE.age.
    #   --force           Overwrite an existing output file.
    #   --verify          Decrypt the result with your private key and confirm it matches FILE.
    #   --delete          Delete FILE after a successful --verify. This is an ordinary delete, not a secure erase.
    ['encrypt']='encrypt(str --identity|-i:file --recipient|-r:str+ --recipient-file|-R:file+ --no-self --no-sign --armor|-a --output|-o:str --force|-f --verify --delete --help|-h)'

    # Create a signed, encrypted secure archive (.valt) from files and directories.
    # A public companion (.valt.pub) that is safe to share is also created. Your own public key is
    # always a recipient unless --no-self is given. You will be prompted for the passphrase that
    # protects your private key.
    #   INPUT...          Files and directories to add. '-C DIR' changes to DIR before processing the inputs that follow it; an '@' prefixed path is a tar archive whose contents are added.
    #   --identity        Your private key file, used to sign and to find your public key (the .pub file next to it); default: the default key (see 'valt default-key').
    #   --recipient       Also encrypt to this recipient (an age public key). Can be repeated.
    #   --recipient-file  Also encrypt to the recipient(s) in this file, e.g. a valt .pub file. Can be repeated.
    #   --no-self         Do not include your own public key as a recipient.
    #   --name            The archive file name prefix (default: your user name).
    #   --zone            The time zone for the timestamp in the archive name: 'local' (the system time zone), 'UTC', or a name such as 'America/Los_Angeles' (default: local).
    #   --user-text       Text to include in the archive's README. Can contain '\n'.
    #   --output-dir      The directory to write the archive to (default: the current directory).
    #   --force           Overwrite an existing archive.
    #   --no-mac-metadata  Do not keep the macOS metadata (extended attributes such as Finder tags, ACLs and file flags) of the files added. It is kept by default, but only macOS tar restores it; other tars, e.g. on Linux, may warn about it.
    ['archive create']='archiveCreate(--identity|-i:file --recipient|-r:str+ --recipient-file|-R:file+ --no-self --name|-n:str --zone|-z:str --user-text|-u:str --output-dir|-o:dir --force|-f --no-mac-metadata --help|-h *)'

    # Verify both signatures of a secure archive (.valt) without extracting it.
    # The inner signature is checked after decrypting, so you will be prompted for the passphrase that
    # protects your private key.
    #   ARCHIVE     The secure archive (.valt).
    #   --identity  Your private key file (default: the default key; see 'valt default-key').
    ['archive verify']='archiveVerify(file --identity|-i:file --help|-h)'

    # Verify and extract a secure archive (.valt). Same as 'valt decrypt ARCHIVE'.
    #   ARCHIVE       The secure archive (.valt).
    #   --identity    Your private key file (default: the default key; see 'valt default-key').
    #   --output-dir  The existing directory to extract into (default: the current directory).
    ['archive extract']='archiveExtract(file --identity|-i:file --output-dir|-o:dir --help|-h)'

    # Generate random passphrases. Passphrases are made of words chosen at random from a list of
    # 17,576, so they are much easier to remember than random passwords of similar strength. Use
    # 'valt pass-check' to check the strength of one.
    #   --words      The number of words in each passphrase.
    #   --count      The number of passphrases to generate.
    #   --separator  The text between words (default: a space).
    ['passphrase']='passphrase(--words|-w:+int=5 --count|-n:+int=1 --separator|-s:str --help|-h)'

    # Generate random passwords, using letters, digits and symbols, with a random length between
    # --min and --max. Use 'valt pass-check' to check the strength of one.
    #   --min    The minimum length.
    #   --max    The maximum length.
    #   --count  The number of passwords to generate.
    ['password']='password(--min:+int=24 --max:+int=32 --count|-n:+int=1 --help|-h)'

    # Check a password or passphrase: rate its strength, and look it up in the HaveIBeenPwned
    # database of known data breaches. You will be prompted for it; it is read from standard input
    # if that is not a terminal.
    #   --use-case      What it protects: 'account' (an online account, whose password hashes could be stolen and attacked quickly) or 'file' (an encrypted file or private key, such as a valt key, protected by age's deliberately slow hashing).
    #   --threat-level  How capable an attacker to judge strength against.
    #   --breach-only   Only look it up in the breach database; do not rate its strength.
    #
    # The exit status is 0 if it appears safe to use, 1 if not, or 2 if it is strong enough but known
    # breaches could not be checked (e.g. when offline). With --breach-only it is 0 if it was not
    # found and 1 if it was.
    #
    # Only the first 5 characters of a SHA-1 hash of it are sent, so neither it nor its full hash
    # leaves this computer (see https://haveibeenpwned.com/API/v3#PwnedPasswords).
    ['pass-check']='passCheck(--use-case|-u:account|file=account --threat-level|-t:casual|motivated|professional|nation-state=professional --breach-only|-b --help|-h)'

    # Verify a key pair, and optionally files encrypted or archived with it. You will be prompted for the
    # passphrase that protects the private key, once.
    #   FILE...     Public keys (.pub) to check against the private key, and encrypted files (e.g. .age) and secure archives (.valt) to verify.
    #   --identity  The private key file (default: the default key; see 'valt default-key').
    #
    # The private key must decrypt with its passphrase. Each public key must match it: the keys it
    # contains must be the private key's, a file encrypted to it must decrypt with the private key,
    # and a signature made with the private key must verify. With no public key given, the .pub
    # file next to the private key is used, if there is one.
    #
    # Each encrypted file must decrypt with the private key (nothing is written), and its signature
    # (FILE.minisig) must verify if it has one; a warning is shown if it does not. Each secure
    # archive must have both of its signatures verify, as with 'valt archive verify'.
    ['verify']='verify(--identity|-i:file --help|-h *)'

    # Show or set the default private key file, used by any command when no key is given.
    #   KEY_FILE  The valt private key file to use by default.
    #   --clear   Remove the setting, so that the built-in default is used.
    #
    # With no arguments, shows the default key and where it comes from. The default is, in order:
    # the VALT_KEY_FILE environment variable, the setting made here (stored in valt.conf in the
    # valt config directory), or valt.key in the valt config directory.
    ['default-key']='defaultKey(file? --clear --help|-h)'
)

ARGS_PARSER_BEGIN="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 🚫 BEGIN generated code: DO NOT EDIT 🚫 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

parseCommand() {
    _opts=()
    _args=()
    parseCommonOptions valt "$@"; shift $?
    case "$1 ${2:-}" in
        "archive create") shift 2; parseArchiveCreateArgs "$@"; (( _opts['help'] )) && archiveCreateCmdUsage || archiveCreateCmd ;;
        "archive extract") shift 2; parseArchiveExtractArgs "$@"; (( _opts['help'] )) && archiveExtractCmdUsage || archiveExtractCmd ;;
        "archive verify") shift 2; parseArchiveVerifyArgs "$@"; (( _opts['help'] )) && archiveVerifyCmdUsage || archiveVerifyCmd ;;
        *)
            case "$1" in
                decrypt) shift; parseDecryptArgs "$@"; (( _opts['help'] )) && decryptCmdUsage || decryptCmd ;;
                default-key) shift; parseDefaultKeyArgs "$@"; (( _opts['help'] )) && defaultKeyCmdUsage || defaultKeyCmd ;;
                encrypt) shift; parseEncryptArgs "$@"; (( _opts['help'] )) && encryptCmdUsage || encryptCmd ;;
                keys) shift; parseKeysArgs "$@"; (( _opts['help'] )) && keysCmdUsage || keysCmd ;;
                paper) shift; parsePaperArgs "$@"; (( _opts['help'] )) && paperCmdUsage || paperCmd ;;
                pass-check) shift; parsePassCheckArgs "$@"; (( _opts['help'] )) && passCheckCmdUsage || passCheckCmd ;;
                passphrase) shift; parsePassphraseArgs "$@"; (( _opts['help'] )) && passphraseCmdUsage || passphraseCmd ;;
                password) shift; parsePasswordArgs "$@"; (( _opts['help'] )) && passwordCmdUsage || passwordCmd ;;
                verify) shift; parseVerifyArgs "$@"; (( _opts['help'] )) && verifyCmdUsage || verifyCmd ;;
                archive)
                    case "${2:-}" in
                        -h | --help) archiveCmdUsage ;;
                        *) archiveCmdUsage "archive requires a subcommand: create, extract, verify" ;;
                    esac
                    ;;
                *) usage "unknown command: $1" ;;
            esac
            ;;
    esac
}

archiveCmdUsage() {
    echo
    show "Usage:" bold blue "valt archive" "SUBCOMMAND [OPTIONS]"
    echo
    echo "Subcommands:"
    echo
    option "create" "Create a signed, encrypted secure archive (.valt) from files and directories." 13
    option "extract" "Verify and extract a secure archive (.valt). Same as 'valt decrypt ARCHIVE'." 13
    option "verify" "Verify both signatures of a secure archive (.valt) without extracting it." 13
    echo
    echo "Use 'valt archive SUBCOMMAND --help' for details on a specific subcommand."
    bye "$@"
}

parseArchiveCreateArgs() {
    declare -g _optListRecipient=()
    declare -g _optListRecipientFile=()
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=archiveCreateCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --force | -f) _opts+=(['force']="1"); shift ;;
            --force=*) fail "--force does not accept a value" ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --identity | -i) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --identity"; assertFile "$2"; _opts+=(['identity']="$2"); shift 2 ;;
            --identity=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --identity"; assertFile "${_value}"; _opts+=(['identity']="${_value}"); shift ;;
            --name | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --name"; _opts+=(['name']="$2"); shift 2 ;;
            --name=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --name"; _opts+=(['name']="${_value}"); shift ;;
            --no-mac-metadata) _opts+=(['no-mac-metadata']="1"); shift ;;
            --no-mac-metadata=*) fail "--no-mac-metadata does not accept a value" ;;
            --no-self) _opts+=(['no-self']="1"); shift ;;
            --no-self=*) fail "--no-self does not accept a value" ;;
            --output-dir | -o) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --output-dir"; assertDirectory "$2"; _opts+=(['output-dir']="$2"); shift 2 ;;
            --output-dir=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --output-dir"; assertDirectory "${_value}"; _opts+=(['output-dir']="${_value}"); shift ;;
            --recipient | -r) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --recipient"; _optListRecipient+=("$2"); _opts+=(['recipient']="1"); shift 2 ;;
            --recipient=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --recipient"; _optListRecipient+=("${_value}"); _opts+=(['recipient']="1"); shift ;;
            --recipient-file | -R) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --recipient-file"; assertFile "$2"; _optListRecipientFile+=("$2"); _opts+=(['recipient-file']="1"); shift 2 ;;
            --recipient-file=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --recipient-file"; assertFile "${_value}"; _optListRecipientFile+=("${_value}"); _opts+=(['recipient-file']="1"); shift ;;
            --user-text | -u) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --user-text"; _opts+=(['user-text']="$2"); shift 2 ;;
            --user-text=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --user-text"; _opts+=(['user-text']="${_value}"); shift ;;
            --zone | -z) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--user-text|--output-dir|--recipient|--identity|--recipient-file|-u|-r|-z|-f|-n|-o|-h|-i|-R|--zone|--name|--help|--no-mac-metadata|--no-self|--force)$ ) ]] && fail "missing value for --zone"; _opts+=(['zone']="$2"); shift 2 ;;
            --zone=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --zone"; _opts+=(['zone']="${_value}"); shift ;;
            --) shift; _args+=("$@"); break ;;
            *) _args+=("$1"); shift ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

archiveCreateCmdUsage() {
    echo
    show bold "Create a signed, encrypted secure archive (.valt) from files and directories. A public companion"
    show bold "(.valt.pub) that is safe to share is also created. Your own public key is always a recipient unless"
    show bold "--no-self is given. You will be prompted for the passphrase that protects your private key."
    echo
    show "Usage:" bold blue "valt archive create" "[INPUT...] [-f] [-i IDENTITY] [-n NAME] [--no-mac-metadata] [--no-self]"
    echo "                           [-o OUTPUT-DIR] [-r RECIPIENT]... [-R RECIPIENT-FILE]... [-u USER-TEXT]"
    echo "                           [-z ZONE]"
    echo
    option "INPUT..." "Files and directories to add. '-C DIR' changes to DIR" 41
    option "" "before processing the inputs that follow it; an '@'" 41
    option "" "prefixed path is a tar archive whose contents are added." 41
    option "-i, --identity IDENTITY" "Your private key file, used to sign and to find your public" 41
    option "" "key (the .pub file next to it); default: the default key" 41
    option "" "(see 'valt default-key')." 41
    option "-r, --recipient RECIPIENT" "Also encrypt to this recipient (an age public key). Can be" 41
    option "" "repeated." 41
    option "-R, --recipient-file RECIPIENT-FILE" "Also encrypt to the recipient(s) in this file, e.g. a valt" 41
    option "" ".pub file. Can be repeated." 41
    option "--no-self" "Do not include your own public key as a recipient." 41
    option "-n, --name NAME" "The archive file name prefix (default: your user name)." 41
    option "-z, --zone ZONE" "The time zone for the timestamp in the archive name:" 41
    option "" "'local' (the system time zone), 'UTC', or a name such as" 41
    option "" "'America/Los_Angeles' (default: local)." 41
    option "-u, --user-text USER-TEXT" "Text to include in the archive's README. Can contain '\\n'." 41
    option "-o, --output-dir OUTPUT-DIR" "The directory to write the archive to (default: the current" 41
    option "" "directory)." 41
    option "-f, --force" "Overwrite an existing archive." 41
    option "--no-mac-metadata" "Do not keep the macOS metadata (extended attributes such as" 41
    option "" "Finder tags, ACLs and file flags) of the files added. It is" 41
    option "" "kept by default, but only macOS tar restores it; other" 41
    option "" "tars, e.g. on Linux, may warn about it." 41
    option "-h, --help" "Print this help message." 41
    declare -F archiveCreateCmdUsageExtra > /dev/null && archiveCreateCmdUsageExtra
    bye "$@"
}

parseArchiveExtractArgs() {
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=archiveExtractCmdUsage
    local _argIndex=0 _value
    while (( $# > 0 )); do
        case "$1" in
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --identity | -i) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--output-dir|--identity|-o|-h|-i|--help)$ ) ]] && fail "missing value for --identity"; assertFile "$2"; _opts+=(['identity']="$2"); shift 2 ;;
            --identity=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --identity"; assertFile "${_value}"; _opts+=(['identity']="${_value}"); shift ;;
            --output-dir | -o) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--output-dir|--identity|-o|-h|-i|--help)$ ) ]] && fail "missing value for --output-dir"; assertDirectory "$2"; _opts+=(['output-dir']="$2"); shift 2 ;;
            --output-dir=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --output-dir"; assertDirectory "${_value}"; _opts+=(['output-dir']="${_value}"); shift ;;
            --) shift
                while (( $# > 0 )); do
                    (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"
                    _args+=("$1"); (( _argIndex++ )); shift
                done ;;
            *) (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"; _args+=("$1"); (( _argIndex++ )); shift ;;
        esac
    done
    (( _opts['help'] || _argIndex >= 1 )) || { local -a _missingArgs=("ARCHIVE"); _missingArgs=("${_missingArgs[@]:${_argIndex}}"); (( ${#_missingArgs[@]} == 1 )) && fail "missing required argument: ${_missingArgs[0]}" || fail "missing required arguments: ${_missingArgs[*]}"; }
    declare -g _failHandler="${_prevFailHandler}"
}

archiveExtractCmdUsage() {
    echo
    show bold "Verify and extract a secure archive (.valt). Same as 'valt decrypt ARCHIVE'."
    echo
    show "Usage:" bold blue "valt archive extract" "ARCHIVE [-i IDENTITY] [-o OUTPUT-DIR]"
    echo
    option "ARCHIVE" "The secure archive (.valt)." 33
    option "-i, --identity IDENTITY" "Your private key file (default: the default key; see 'valt" 33
    option "" "default-key')." 33
    option "-o, --output-dir OUTPUT-DIR" "The existing directory to extract into (default: the current" 33
    option "" "directory)." 33
    option "-h, --help" "Print this help message." 33
    declare -F archiveExtractCmdUsageExtra > /dev/null && archiveExtractCmdUsageExtra
    bye "$@"
}

parseArchiveVerifyArgs() {
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=archiveVerifyCmdUsage
    local _argIndex=0 _value
    while (( $# > 0 )); do
        case "$1" in
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --identity | -i) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--identity|-h|-i|--help)$ ) ]] && fail "missing value for --identity"; assertFile "$2"; _opts+=(['identity']="$2"); shift 2 ;;
            --identity=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --identity"; assertFile "${_value}"; _opts+=(['identity']="${_value}"); shift ;;
            --) shift
                while (( $# > 0 )); do
                    (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"
                    _args+=("$1"); (( _argIndex++ )); shift
                done ;;
            *) (( _argIndex == 0 )) && assertFile "$1" || unknownArg "$1"; _args+=("$1"); (( _argIndex++ )); shift ;;
        esac
    done
    (( _opts['help'] || _argIndex >= 1 )) || { local -a _missingArgs=("ARCHIVE"); _missingArgs=("${_missingArgs[@]:${_argIndex}}"); (( ${#_missingArgs[@]} == 1 )) && fail "missing required argument: ${_missingArgs[0]}" || fail "missing required arguments: ${_missingArgs[*]}"; }
    declare -g _failHandler="${_prevFailHandler}"
}

