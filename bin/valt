    show bold "changes. The passphrase is not required, since the private key is included in its encrypted form."
    echo
    show "Usage:" bold blue "valt paper" "[KEY_FILE] [-c CSS] [-k KEY-INFO] [-n NAME] [-t TEMPLATE]"
    echo
    option "KEY_FILE" "The private key file (default: the default key; see 'valt" 29
    option "" "default-key')." 29
    option "-n, --name NAME" "Use the NAME.key file in the valt config directory, e.g. bob ->" 29
    option "" "bob.key." 29
    option "-k, --key-info KEY-INFO" "Key info file to use instead of the default." 29
    option "-t, --template TEMPLATE" "HTML template file to use instead of the default." 29
    option "-c, --css CSS" "CSS file with style overrides to apply." 29
    option "-h, --help" "Print this help message." 29
    echo
    echo "The PDF is opened when done, so that you can check and print it. Please ensure that you print at"
    echo "least one copy and write your passphrase on the last page (or leave the passphrase blank and add"
    echo "instructions on where to find it in the Notes section). See 'valt keys --help' for document"
    echo "customization details."
    declare -F paperCmdUsageExtra > /dev/null && paperCmdUsageExtra
    bye "$@"
}

parsePassCheckArgs() {
    _opts+=(['threat-level']="professional" ['use-case']="account")
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=passCheckCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --breach-only | -b) _opts+=(['breach-only']="1"); shift ;;
            --breach-only=*) fail "--breach-only does not accept a value" ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --threat-level | -t) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--breach-only|--threat-level|--use-case|-t|-u|-b|-h|--help)$ ) ]] && fail "missing value for --threat-level"; [[ "|casual|motivated|professional|nation-state|" == *"|$2|"* ]] || fail "$2 must be one of: casual|motivated|professional|nation-state"; _opts+=(['threat-level']="$2"); shift 2 ;;
            --threat-level=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --threat-level"; [[ "|casual|motivated|professional|nation-state|" == *"|${_value}|"* ]] || fail "${_value} must be one of: casual|motivated|professional|nation-state"; _opts+=(['threat-level']="${_value}"); shift ;;
            --use-case | -u) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--breach-only|--threat-level|--use-case|-t|-u|-b|-h|--help)$ ) ]] && fail "missing value for --use-case"; [[ "|account|file|" == *"|$2|"* ]] || fail "$2 must be one of: account|file"; _opts+=(['use-case']="$2"); shift 2 ;;
            --use-case=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --use-case"; [[ "|account|file|" == *"|${_value}|"* ]] || fail "${_value} must be one of: account|file"; _opts+=(['use-case']="${_value}"); shift ;;
            --) shift; (( $# == 0 )) || unknownArg "$1" ;;
            *) unknownArg "$1" ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

passCheckCmdUsage() {
    echo
    show bold "Check a password or passphrase: rate its strength, and look it up in the HaveIBeenPwned database of"
    show bold "known data breaches. You will be prompted for it; it is read from standard input if that is not a"
    show bold "terminal."
    echo
    show "Usage:" bold blue "valt pass-check" "[-b] [-t THREAT-LEVEL] [-u account|file]"
    echo
    option "-u, --use-case account|file" "What it protects: 'account' (an online account, whose password" 37
    option "" "hashes could be stolen and attacked quickly) or 'file' (an" 37
    option "" "encrypted file or private key, such as a valt key, protected by" 37
    option "" "age's deliberately slow hashing). (default: account)" 37
    option "-t, --threat-level THREAT-LEVEL" "How capable an attacker to judge strength against. One of:" 37
    option "" "casual, motivated, professional, nation-state. (default:" 37
    option "" "professional)" 37
    option "-b, --breach-only" "Only look it up in the breach database; do not rate its" 37
    option "" "strength." 37
    option "-h, --help" "Print this help message." 37
    echo
    echo "The exit status is 0 if it appears safe to use, 1 if not, or 2 if it is strong enough but known"
    echo "breaches could not be checked (e.g. when offline). With --breach-only it is 0 if it was not"
    echo "found and 1 if it was."
    echo
    echo "Only the first 5 characters of a SHA-1 hash of it are sent, so neither it nor its full hash"
    echo "leaves this computer (see https://haveibeenpwned.com/API/v3#PwnedPasswords)."
    declare -F passCheckCmdUsageExtra > /dev/null && passCheckCmdUsageExtra
    bye "$@"
}

parsePassphraseArgs() {
    _opts+=(['count']="1" ['words']="5")
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=passphraseCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --count | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--count|-w|-s|-n|-h|--help|--words|--separator)$ ) ]] && fail "missing value for --count"; assertPositiveInt "$2"; _opts+=(['count']="$2"); shift 2 ;;
            --count=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --count"; assertPositiveInt "${_value}"; _opts+=(['count']="${_value}"); shift ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --separator | -s) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--count|-w|-s|-n|-h|--help|--words|--separator)$ ) ]] && fail "missing value for --separator"; _opts+=(['separator']="$2"); shift 2 ;;
            --separator=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --separator"; _opts+=(['separator']="${_value}"); shift ;;
            --words | -w) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--count|-w|-s|-n|-h|--help|--words|--separator)$ ) ]] && fail "missing value for --words"; assertPositiveInt "$2"; _opts+=(['words']="$2"); shift 2 ;;
            --words=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --words"; assertPositiveInt "${_value}"; _opts+=(['words']="${_value}"); shift ;;
            --) shift; (( $# == 0 )) || unknownArg "$1" ;;
            *) unknownArg "$1" ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

passphraseCmdUsage() {
    echo
    show bold "Generate random passphrases. Passphrases are made of words chosen at random from a list of 17,576,"
    show bold "so they are much easier to remember than random passwords of similar strength. Use 'valt pass-check'"
    show bold "to check the strength of one."
    echo
    show "Usage:" bold blue "valt passphrase" "[-n COUNT] [-s SEPARATOR] [-w WORDS]"
    echo
    option "-w, --words WORDS" "The number of words in each passphrase. (default: 5)" 31
    option "-n, --count COUNT" "The number of passphrases to generate. (default: 1)" 31
    option "-s, --separator SEPARATOR" "The text between words (default: a space)." 31
    option "-h, --help" "Print this help message." 31
    declare -F passphraseCmdUsageExtra > /dev/null && passphraseCmdUsageExtra
    bye "$@"
}

parsePasswordArgs() {
    _opts+=(['count']="1" ['max']="32" ['min']="24")
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=passwordCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --count | -n) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--min|--count|-n|-h|--help|--max)$ ) ]] && fail "missing value for --count"; assertPositiveInt "$2"; _opts+=(['count']="$2"); shift 2 ;;
            --count=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --count"; assertPositiveInt "${_value}"; _opts+=(['count']="${_value}"); shift ;;
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --max) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--min|--count|-n|-h|--help|--max)$ ) ]] && fail "missing value for --max"; assertPositiveInt "$2"; _opts+=(['max']="$2"); shift 2 ;;
            --max=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --max"; assertPositiveInt "${_value}"; _opts+=(['max']="${_value}"); shift ;;
            --min) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--min|--count|-n|-h|--help|--max)$ ) ]] && fail "missing value for --min"; assertPositiveInt "$2"; _opts+=(['min']="$2"); shift 2 ;;
            --min=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --min"; assertPositiveInt "${_value}"; _opts+=(['min']="${_value}"); shift ;;
            --) shift; (( $# == 0 )) || unknownArg "$1" ;;
            *) unknownArg "$1" ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

passwordCmdUsage() {
    echo
    show bold "Generate random passwords, using letters, digits and symbols, with a random length between --min and"
    show bold "--max. Use 'valt pass-check' to check the strength of one."
    echo
    show "Usage:" bold blue "valt password" "[-n COUNT] [--max MAX] [--min MIN]"
    echo
    option "--min MIN" "The minimum length. (default: 24)" 23
    option "--max MAX" "The maximum length. (default: 32)" 23
    option "-n, --count COUNT" "The number of passwords to generate. (default: 1)" 23
    option "-h, --help" "Print this help message." 23
    declare -F passwordCmdUsageExtra > /dev/null && passwordCmdUsageExtra
    bye "$@"
}

parseVerifyArgs() {
    local _prevFailHandler="${_failHandler}"
    declare -g _failHandler=verifyCmdUsage
    local _value
    while (( $# > 0 )); do
        case "$1" in
            --help | -h) _opts+=(['help']="1"); shift ;;
            --help=*) fail "--help does not accept a value" ;;
            --identity | -i) [[ -z "$2" || ( "$2" == -* && "$2" =~ ^(--identity|-h|-i|--help)$ ) ]] && fail "missing value for --identity"; assertFile "$2"; _opts+=(['identity']="$2"); shift 2 ;;
            --identity=*) _value="${1#*=}"; [[ -n "${_value}" ]] || fail "missing value for --identity"; assertFile "${_value}"; _opts+=(['identity']="${_value}"); shift ;;
            --) shift; _args+=("$@"); break ;;
            *) _args+=("$1"); shift ;;
        esac
    done
    declare -g _failHandler="${_prevFailHandler}"
}

verifyCmdUsage() {
    echo
    show bold "Verify a key pair, and optionally files encrypted or archived with it. You will be prompted for the"
    show bold "passphrase that protects the private key, once."
    echo
    show "Usage:" bold blue "valt verify" "[FILE...] [-i IDENTITY]"
    echo
    option "FILE..." "Public keys (.pub) to check against the private key, and encrypted" 29
    option "" "files (e.g. .age) and secure archives (.valt) to verify." 29
    option "-i, --identity IDENTITY" "The private key file (default: the default key; see 'valt" 29
    option "" "default-key')." 29
    option "-h, --help" "Print this help message." 29
    echo
    echo "The private key must decrypt with its passphrase. Each public key must match it: the keys it"
    echo "contains must be the private key's, a file encrypted to it must decrypt with the private key,"
    echo "and a signature made with the private key must verify. With no public key given, the .pub"
    echo "file next to the private key is used, if there is one."
    echo
    echo "Each encrypted file must decrypt with the private key (nothing is written), and its signature"
    echo "(FILE.minisig) must verify if it has one; a warning is shown if it does not. Each secure"
    echo "archive must have both of its signatures verify, as with 'valt archive verify'."
    declare -F verifyCmdUsageExtra > /dev/null && verifyCmdUsageExtra
    bye "$@"
}

ARGS_PARSER_END="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 🚫 END generated code: DO NOT EDIT 🚫 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

SECTION="--+-+-----+-++(-++(---++++(---+( COMMANDS )+---)++++---)++-)++-+------+-+--"

keysCmd() {
    require 'valt/paper-keys'
    local name="${_opts['name']}"
    assertValidFileName "${name}"
    local outputDir="${_opts['output-dir']:-${valtConfigDir}}"
    local publicKeyFile="${outputDir}/${name}.${valtPublicKeySuffix}"
    local privateKeyFile="${outputDir}/${name}.${valtPrivateKeySuffix}"
    local verify=1
    (( _opts['no-verify'] || _opts['quick'] )) && verify=0
    (( _opts['no-advice'] || _opts['quick'] )) && declare -gx skipKeyPassphraseAdvice=1
    (( _opts['allow-weak-passphrase'] )) && declare -gx allowWeakKeyPassphrase=1

    if (( ! _opts['force'] )); then
        assertFileDoesNotExist "${privateKeyFile}"
        assertFileDoesNotExist "${publicKeyFile}"
    fi

    createKeys "${name}" "${outputDir}" "${publicKeyFile}" "${privateKeyFile}" ${verify} "${_opts['force']:-0}"
    offerDefaultKey "${privateKeyFile}" "${_opts['default']:-0}"

    (( _opts['no-pdf'] )) && return 0
    if isKeyInfoComplete "${_opts['key-info']}"; then
        generatePaperKey "${privateKeyFile}"
        openPaperKey "${privateKeyFile}"
    else
        showPaperKeyDeferred "${privateKeyFile}"
    fi
}

paperCmd() {
    require 'valt/paper-keys'
    local keyFile="${_args[0]:-}"
    if [[ -n ${_opts['name']} ]]; then
        [[ -z ${keyFile} ]] || paperCmdUsage "Specify either --name or KEY_FILE, not both."
        assertValidFileName "${_opts['name']}"
        keyFile="${valtConfigDir}/${_opts['name']}.${valtPrivateKeySuffix}"
    fi
    [[ -n ${keyFile} ]] || keyFile="${ defaultValtKeyFile; }"
    assertFile "${keyFile}" "private key file"
    generatePaperKey "${keyFile}"
    openPaperKey "${keyFile}"
}

decryptCmd() {
    local file="${_args[0]}"
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"

    if [[ ${file} == *.valt ]]; then
        extractArchive "${file}" "${keyFile}" "${_opts['output']:-${PWD}}"
    else
        decryptFile "${file}" "${keyFile}"
    fi
}

encryptCmd() {
    require 'valt/paper-keys'
    local file="${_args[0]}"
    [[ -d ${file} ]] && encryptCmdUsage "${file} is a directory; use 'valt archive create' for directories and multiple files."
    assertFile "${file}"
    (( _opts['delete'] && ! _opts['verify'] )) && encryptCmdUsage "--delete requires --verify."
    (( _opts['verify'] && _opts['no-self'] )) && encryptCmdUsage "--verify cannot be combined with --no-self, since your key could not decrypt the file."

    local output="${_opts['output']:-${file}.${_ageFileExtension}}"
    local sign=1
    (( _opts['no-sign'] )) && sign=0
    if [[ ${output} == '-' ]]; then
        (( sign )) && encryptCmdUsage "Signing requires an output file; use --no-sign with '--output -'."
        (( _opts['verify'] )) && encryptCmdUsage "--verify requires an output file."
    else
        assertCanWrite "${output}"
        (( sign )) && assertCanWrite "${output}.${_signatureFileSuffix}"
    fi

    local keyFile; keyFile="${ identityKeyFile; }"
    local -a recipientArgs=()
    addRecipientArgs recipientArgs "${keyFile}" encryptCmdUsage

    # Signing and verification both decrypt the private key, so ask for its passphrase once.
    # Shadow with a local so that it goes out of scope when we return.

    local rayvnTest_ValtKeyPassphrase="${rayvnTest_ValtKeyPassphrase}"
    if (( sign || _opts['verify'] )); then
        assertFile "${keyFile}" "private key file"
        _prepareKey "${keyFile}"
    fi

    local -a encryptArgs=("${file}" "${recipientArgs[@]}")
    (( _opts['armor'] )) && encryptArgs+=(--armor)
    if [[ ${output} == '-' ]]; then
        encrypt "${encryptArgs[@]}" || fail
        return 0
    fi
    encrypt "${encryptArgs[@]}" -o "${output}" || fail
    show "Encrypted" cyan "${ tildePath "${file}"; }" "to" bold "${ tildePath "${output}"; }"

    if (( sign )); then
        signFile "${keyFile}" "${output}"
        show "Signed" bold "${ tildePath "${output}"; }" "with" cyan "${ tildePath "${keyFile}"; }"
    fi
    (( _opts['verify'] )) && verifyEncryptedFile "${file}" "${output}" "${keyFile}"
    if (( _opts['delete'] )); then
        rm "${file}" || fail
        show "Deleted" bold "${ tildePath "${file}"; }"
    fi
    if (( sign || _opts['verify'] )); then
        remindPaperKey "${keyFile}"
    fi
}

archiveCreateCmd() {
    require 'valt/paper-keys' 'valt/archive'
    (( ${#_args[@]} )) || archiveCreateCmdUsage "missing required argument: INPUT..."
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    local -a recipientArgs=()
    addRecipientArgs recipientArgs "${keyFile}" archiveCreateCmdUsage

    local -a args=("${_args[@]}" -i "${keyFile}" "${recipientArgs[@]}")
    [[ -n ${_opts['name']} ]] && args+=(-n "${_opts['name']}")
    [[ -n ${_opts['zone']} ]] && args+=(-z "${_opts['zone']}")
    [[ -n ${_opts['user-text']} ]] && args+=(-u "${_opts['user-text']}")
    [[ -n ${_opts['output-dir']} ]] && args+=(-o "${_opts['output-dir']}")
    (( _opts['force'] )) && args+=(-f)
    (( _opts['no-mac-metadata'] )) && args+=(--no-mac-metadata)

    local archive; archive="${ newSecureArchive "${args[@]}"; }" || fail
    show "Created secure archive" bold "${ tildePath "${archive}"; }"
    show "Public companion (safe to share):" cyan "${ tildePath "${archive}.pub"; }"
    remindPaperKey "${keyFile}"
}

archiveVerifyCmd() {
    require 'valt/archive'
    local archive="${_args[0]}"
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    show "Verifying secure archive" cyan "${ tildePath "${archive}"; }"
    verifySecureArchive "${archive}" -i "${keyFile}" || fail
    show "Signatures verified for" bold "${ tildePath "${archive}"; }"
}

archiveExtractCmd() {
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    extractArchive "${_args[0]}" "${keyFile}" "${_opts['output-dir']:-${PWD}}"
}

passphraseCmd() {
    require 'valt/password'
    local phrase i
    for (( i = 0; i < _opts['count']; i++ )); do
        if [[ -n ${_opts['separator']+set} ]]; then
            generatePassphrase phrase "${_opts['words']}" "${_opts['separator']}"
        else
            generatePassphrase phrase "${_opts['words']}"
        fi
        [[ -n ${phrase} ]] || fail "failed to generate a passphrase"
        echo "${phrase}"
    done
}

passwordCmd() {
    require 'valt/password'
    (( _opts['min'] <= _opts['max'] )) || passwordCmdUsage "--min must not be greater than --max."
    local password i
    for (( i = 0; i < _opts['count']; i++ )); do
        generatePassword password "${_opts['min']}" "${_opts['max']}"
        echo "${password}"
    done
}

passCheckCmd() {
    require 'valt/password'
    if (( ! _opts['breach-only'] )); then
        checkSecretStrength
        return
    fi
    local secret apiError breachCount
    readSecret "Enter password or passphrase" secret
    hasNotBeenPwned secret apiError breachCount
    case $? in
        0) show success "Not found in any known breach." ;;
        1) fail "Unable to check for breaches: ${ _curlErrorMessage "${apiError}"; }" ;;
        2)
            local plural='es'; (( breachCount == 1 )) && plural=''
            show error "Found in ${ printf "%'d" "${breachCount}"; } breach${plural}." "Do not use it."
            return 1
            ;;
    esac
}

verifyCmd() {
    local keyFile; keyFile="${ identityKeyFile; }"
    assertFile "${keyFile}" "private key file"
    local -a publicKeyFiles=() encryptedFiles=() archiveFiles=()
    local file
    for file in "${_args[@]}"; do
        assertFile "${file}"
        if [[ "${file}" == *."${valtPublicKeySuffix}" ]]; then
            publicKeyFiles+=("${file}")
        elif [[ "${file}" == *.valt ]]; then
            archiveFiles+=("${file}")
        elif isAgeEncryptedFile "${file}"; then
            encryptedFiles+=("${file}")
        else
            verifyCmdUsage "not a public key (.${valtPublicKeySuffix}), encrypted file or secure archive (.valt): ${file}"
        fi
    done
    if (( ! ${#publicKeyFiles[@]} )); then
        local defaultPublicKey="${keyFile%."${valtPrivateKeySuffix}"}.${valtPublicKeySuffix}"
        [[ -f "${defaultPublicKey}" ]] && publicKeyFiles=("${defaultPublicKey}")
    fi

    # Ask for the passphrase once, for every check. Shadow with a local so that it goes out of scope when we return.

    local rayvnTest_ValtKeyPassphrase="${rayvnTest_ValtKeyPassphrase}"
    _prepareKey "${keyFile}"
    recipient "${keyFile}" > /dev/null || fail
    show "Private key" bold "${ tildePath "${keyFile}"; }" "decrypts with its passphrase. ${successCheckMark}"
    (( ${#publicKeyFiles[@]} )) || show italic "No public key was found next to it to check against."

    for file in "${publicKeyFiles[@]}"; do
        verifyValtKeys "${file}" "${keyFile}"
        show "Public key" bold "${ tildePath "${file}"; }" "matches the private key. ${successCheckMark}"
    done

    for file in "${encryptedFiles[@]}"; do
        verifySignatureIfPresent "${file}" "${keyFile}"
        decrypt -i "${keyFile}" -o /dev/null "${file}" || fail
        if [[ -f "${file}.${_signatureFileSuffix}" ]]; then
            show "Encrypted file" bold "${ tildePath "${file}"; }" "decrypts with the private key, and its signature verifies. ${successCheckMark}"
        else
            show "Encrypted file" bold "${ tildePath "${file}"; }" "decrypts with the private key. ${successCheckMark}"
        fi
    done

    if (( ${#archiveFiles[@]} )); then
        require 'valt/archive'
        for file in "${archiveFiles[@]}"; do
            verifySecureArchive "${file}" -i "${keyFile}" || fail
            show "Signatures verified for" bold "${ tildePath "${file}"; }" "${successCheckMark}"
        done
    fi
}

defaultKeyCmd() {
    if (( _opts['clear'] )); then
        [[ -z ${_args[0]:-} ]] || defaultKeyCmdUsage "Specify either KEY_FILE or --clear, not both."
        setDefaultValtKeyFile
        show "Removed the default key setting."
    elif [[ -n ${_args[0]:-} ]]; then
        setDefaultValtKeyFile "${_args[0]}"
        show "Default key set to" bold "${ tildePath "${ defaultValtKeyFile; }"; }" glue "."
        [[ -n ${VALT_KEY_FILE:-} ]] && warn "VALT_KEY_FILE is set, and overrides this setting."
    fi

    local keyFile; keyFile="${ defaultValtKeyFile; }"
    local source; source="${ defaultValtKeyFileSource; }"
    case "${source}" in
        VALT_KEY_FILE) source='the VALT_KEY_FILE environment variable' ;;
        built-in) source='the built-in default' ;;
        *) source="${ tildePath "${source}"; }" ;;
    esac
    show "Default key:" bold "${ tildePath "${keyFile}"; }" "(from ${source})"
    [[ -f "${keyFile}" ]] || warn "${ tildePath "${keyFile}"; } does not exist; create a key pair with 'valt keys'."
    return 0
}

SECTION="--+-+-----+-++(-++(---++++(---+( SHARED FUNCTIONS )+---)++++---)++-)++-+------+-+--"

# Prompts for a password or passphrase, then shows its strength report for the use-case and threat-level options.
# Returns 1 if it is unsafe to use, or 2 if it is strong enough but known breaches could not be checked.

checkSecretStrength() {
    local secret score line
    local -a report=()
    readSecret "Enter password or passphrase" secret
    passwordStrength secret "${_opts['use-case']}" "${_opts['threat-level']}" score report
    local result=$?
    echo
    for line in "${report[@]}"; do
        echo "${line}"
    done
    return ${result}
}

# Reads a secret into the named var: with a hidden prompt on a terminal, otherwise one line from standard input.

readSecret() {
    local prompt="$1"
    local -n secretRef=$2
    if [[ -t 0 ]]; then
        readPassword "${prompt}" secretRef || fail
    else
        IFS= read -r secretRef || [[ -n ${secretRef} ]] || fail "no input"
    fi
    [[ -n ${secretRef} ]] || fail "cancelled"
}

createKeys() {
    local name="$1" outputDir="$2" publicKeyFile="$3" privateKeyFile="$4" verify=$5 replace=$6
    echo
    header -u "Generating Keys"

    # When replacing, create the new keys elsewhere first, so that a failure (e.g. a rejected passphrase) leaves the
    # existing keys in place.

    if (( replace )); then

        # Stage in the output directory, so that the move is a rename on the same file system

        declare -g keysStagingDir="${outputDir}/.${name}-new-$$"
        addExitHandler removeKeysStagingDir
        withUmask 0077 mkdir "${keysStagingDir}" || fail "could not create ${keysStagingDir}"
        newValtKeys "${name}" "${keysStagingDir}" || fail
        mv -f "${keysStagingDir}/${name}.${valtPublicKeySuffix}" "${publicKeyFile}" || fail
        mv -f "${keysStagingDir}/${name}.${valtPrivateKeySuffix}" "${privateKeyFile}" || fail
        removeKeysStagingDir
    else
        newValtKeys "${name}" "${outputDir}" || fail
    fi
    echo
    show "Public key (aka 'recipient') file:" cyan "${ tildePath "${publicKeyFile}"; }" "(includes public signing key)"
    show "Private key (aka 'identity') file:" cyan "${ tildePath "${privateKeyFile}"; }" "(includes public key and both signing keys)"

    if (( verify )); then
        echo
        header 2 "Verifying keys"
        verifyValtKeys "${publicKeyFile}" "${privateKeyFile}"
        show bold "Verified" glue ":"
        echo
        show "  · A file encrypted with" cyan "${name}.pub" "decrypts with passphrase and the" cyan "${name}.key" "private key. ${successCheckMark}"
        show "  · A signature created with" cyan "${name}.key" "for the encrypted file matches. ${successCheckMark} "
    fi
}

# Generates the paper key for privateKeyFile using the key-info, template and css options.

generatePaperKey() {
    local privateKeyFile keyInfoFile='' cssFile='' templateFile=''

    # newPaperKey changes to a work directory, so resolve all paths first.

    setFileVar privateKeyFile "$1" "private key file"
    [[ -n ${_opts['key-info']} ]] && setFileVar keyInfoFile "${_opts['key-info']}" "key info file"
    [[ -n ${_opts['css']} ]] && setFileVar cssFile "${_opts['css']}" "css file"
    [[ -n ${_opts['template']} ]] && setFileVar templateFile "${_opts['template']}" "template file"

    local existingPdf; existingPdf="${ _paperKeyFile "${privateKeyFile}"; }"
    local replacing=0
    [[ -f "${existingPdf}" ]] && replacing=1

    echo
    header -u "Generating Paper Key"

    local paperKeyFile
    newPaperKey "${privateKeyFile}" paperKeyFile "${keyInfoFile}" "${cssFile}" "${templateFile}"

    show "Paper key file:" cyan "${ tildePath "${paperKeyFile}"; }"
    echo
    show "Print at least one copy," italic "write your passphrase" "on the last page, and" \
         bold "store copies in secure locations" glue "."
    if (( replacing )); then
        echo
        show bold yellow "The previous paper key was replaced." "Destroy any printed copies of it so that outdated" \
             "contact information is not relied upon."
    fi
}

# Decrypts a single file, verifying its signature first if present.

decryptFile() {
    local file="$1" keyFile="$2"
    local output="${_opts['output']}"
    if [[ -z ${output} ]]; then
        [[ ${file} == *.${_ageFileExtension} ]] \
            || decryptCmdUsage "Cannot derive an output file name from '${file}'; use --output."
        output="${file%.${_ageFileExtension}}"
    fi
    [[ ${output} == '-' ]] || assertCanWrite "${output}"

    verifySignatureIfPresent "${file}" "${keyFile}"

    if [[ ${output} == '-' ]]; then
        decrypt -i "${keyFile}" "${file}" || fail
    else
        decrypt -i "${keyFile}" -o "${output}" "${file}" || fail
        show "Decrypted" cyan "${ tildePath "${file}"; }" "to" bold "${ tildePath "${output}"; }"
    fi
}

# Verifies a single file's detached signature, failing on mismatch and warning if it cannot be checked.

verifySignatureIfPresent() {
    local file="$1" keyFile="$2"
    local signatureFile="${file}.${_signatureFileSuffix}"
    local path; path="${ tildePath "${file}"; }"
    if [[ ! -f "${signatureFile}" ]]; then
        warn "No signature found for" bold "${path}" glue "; its authenticity cannot be verified."
    elif ! command -v minisign &> /dev/null; then
        warn "minisign is not installed; the signature for" bold "${path}" "was not verified."
    else
        ( verifyFileSignature "${keyFile}" "${file}" "${signatureFile}" ) &> /dev/null \
            || fail "Signature verification failed for ${path}: it may have been modified, or was signed with a different key."
    fi
}

# Verifies and extracts a secure archive into destDir.

extractArchive() {
    local file="$1" keyFile="$2" destDir="$3"
    require 'valt/archive'
    show "Verifying and extracting secure archive" cyan "${ tildePath "${file}"; }"
    extractSecureArchive "${file}" -i "${keyFile}" -o "${destDir}" || fail
    show "Extracted to" bold "${ tildePath "${destDir}"; }"
}

# Removes the directory in which replacement keys are created, if any (also run on exit, e.g. after a failure).

removeKeysStagingDir() {
    [[ -n ${keysStagingDir:-} && -d ${keysStagingDir} ]] && rm -rf "${keysStagingDir}"
    return 0
}

# Opens the paper key PDF for keyFile in the default viewer, only on a terminal (not in scripts or tests), so that it
# can be checked and printed. Failing to open it is not an error, since it has been saved.

openPaperKey() {
    [[ -t 0 && -t 1 ]] || return 0
    local pdfFile; pdfFile="${ _paperKeyFile "$1"; }"
    [[ -f "${pdfFile}" ]] || return 0
    ( openUrl "${pdfFile}" ) &> /dev/null || warn "Could not open" bold "${ tildePath "${pdfFile}"; }" glue "; open it to check and print it."
    return 0
}

# Makes keyFile the default key if makeDefault, or if the user agrees when asked (only on a terminal), unless it is
# already the default; otherwise shows how to do so later.

offerDefaultKey() {
    local keyFile; keyFile="${ cd "${ dirname "$1"; }" && pwd -P; }/${ basename "$1"; }"
    local makeDefault=$2
    local defaultKey; defaultKey="${ defaultValtKeyFile; }"
    [[ -f "${defaultKey}" ]] && defaultKey="${ cd "${ dirname "${defaultKey}"; }" && pwd -P; }/${ basename "${defaultKey}"; }"
    [[ ${keyFile} == "${defaultKey}" ]] && return 0

    local path; path="${ tildePath "${keyFile}"; }"
    if (( ! makeDefault )) && [[ -t 0 && -t 1 ]]; then
        require 'rayvn/prompt'
        local choiceIndex=1
        echo
        confirm "Use ${path} as your default key, when no key is given?" yes no choiceIndex
        (( choiceIndex == 0 )) && makeDefault=1
    fi

    echo
    if (( makeDefault )); then
        setDefaultValtKeyFile "${keyFile}"
        show "Default key set to" bold "${path}" glue "."
        [[ -n ${VALT_KEY_FILE:-} ]] && warn "VALT_KEY_FILE is set, and overrides this setting."
    else
        show "To use this key when no key is given, run:" primary "valt default-key ${path}"
    fi
    return 0
}

# Outputs the private key file from --identity, or the default key (see defaultValtKeyFile).

identityKeyFile() {
    echo "${_opts['identity']:-${ defaultValtKeyFile; }}"
}

# Adds -r/-R recipient args from the --recipient, --recipient-file and --no-self options. Unless --no-self is
# given, the public key next to keyFile is included. Calls usageFunction if there would be no recipients.

addRecipientArgs() {
    local -n recipientArgsRef=$1
    local keyFile="$2" usageFunction="$3"
    if (( ! _opts['no-self'] )); then
        local publicKeyFile="${keyFile%.${valtPrivateKeySuffix}}.${valtPublicKeySuffix}"
        [[ -f "${publicKeyFile}" ]] || fail "No public key found at ${ tildePath "${publicKeyFile}"; }; create one with" \
                                            "'valt keys', or use --no-self with --recipient or --recipient-file."
        recipientArgsRef+=(-R "${publicKeyFile}")
    fi
    local recipient
    for recipient in "${_optListRecipient[@]}"; do recipientArgsRef+=(-r "${recipient}"); done
    for recipient in "${_optListRecipientFile[@]}"; do recipientArgsRef+=(-R "${recipient}"); done
    (( ${#recipientArgsRef[@]} )) || ${usageFunction} "--no-self requires at least one --recipient or --recipient-file."
}

# Fails if file exists, unless --force was given.

assertCanWrite() {
    [[ -e "$1" ]] || return 0
    (( _opts['force'] )) || fail "${ tildePath "$1"; } already exists; use --force to overwrite."
}

# Decrypts encryptedFile with keyFile and fails unless the result matches originalFile.

verifyEncryptedFile() {
    local originalFile="$1" encryptedFile="$2" keyFile="$3"
    local workDir; makeSecureTempDir workDir
    decrypt -i "${keyFile}" -o "${workDir}/decrypted" "${encryptedFile}" || fail
    local originalHash; originalHash="${ sha256sum < "${originalFile}"; }"
    local decryptedHash; decryptedHash="${ sha256sum < "${workDir}/decrypted"; }"
    [[ ${originalHash} == "${decryptedHash}" ]] \
        || fail "Verification failed: ${ tildePath "${encryptedFile}"; } does not decrypt to ${ tildePath "${originalFile}"; }."
    show "Verified" bold "${ tildePath "${encryptedFile}"; }" "decrypts to match" cyan "${ tildePath "${originalFile}"; }"
}

# Explains how to generate the paper key for privateKeyFile once key.info is complete.

showPaperKeyDeferred() {
    local privateKeyFile="$1"
    local infoFile; infoFile="${ tildePath "${_opts['key-info']:-${valtConfigDir}/key.info}"; }"
    local command; command=("${ paperKeyCommand "${privateKeyFile}"; }")
    [[ -n ${_opts['key-info']} ]] && command+=(-k "${ tildePath "${_opts['key-info']}"; }")
    [[ -n ${_opts['template']} ]] && command+=(-t "${ tildePath "${_opts['template']}"; }")
    [[ -n ${_opts['css']} ]] && command+=(-c "${ tildePath "${_opts['css']}"; }")

    echo
    show bold yellow "Paper key not generated:" "the" blue "${infoFile}" "file has not been completed."
    echo
    show "Your keys are ready to use now. When you have completed" blue "key.info" glue ", generate the paper key with:"
    echo
    show "    " bold blue "${command[*]}"
}

source rayvn.up 'rayvn/core' 'valt/keys' || exit
main "$@"
